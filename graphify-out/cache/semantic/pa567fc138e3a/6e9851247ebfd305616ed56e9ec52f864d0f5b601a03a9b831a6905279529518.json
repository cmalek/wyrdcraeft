{"nodes": [{"id": "docs_adr_0006_bt_jp2_witness_preparation_is_library_first", "label": "BT JP2 witness preparation is library-first", "file_type": "document", "source_file": "docs/adr/0006-bt-jp2-witness-preparation-is-library-first.md", "source_location": "L1-L63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JP2 preparation stops at image-backed tiles because whole-page OCR on dense two-column Bosworth-Toller scans collapses character scale and page-level provenance is too weak for later page-region-line anchoring. Superseded: the OCR pipeline moved to wordwending."}, {"id": "prepare_pages", "label": "prepare_pages", "file_type": "concept", "source_file": "docs/adr/0006-bt-jp2-witness-preparation-is-library-first.md", "source_location": "L19-L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The library entrypoint turns immutable JP2 pages into overlapping OCR-ready tiles with provenance before any text is treated as canonical."}, {"id": "four_tile_geometry", "label": "Four-tile JP2 geometry", "file_type": "concept", "source_file": "docs/adr/0006-bt-jp2-witness-preparation-is-library-first.md", "source_location": "L25-L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default tiling is left and right columns split into overlapping upper and lower halves; non-standard layouts emit fallback_whole_page_only or unsupported_layout instead of silent forced tiling."}, {"id": "ocr_cli_bosworth_toller", "label": "wyrdcraeft ocr bosworth-toller", "file_type": "concept", "source_file": "docs/adr/0006-bt-jp2-witness-preparation-is-library-first.md", "source_location": "L55-L63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The operator CLI does not change the library-first entrypoint: OCR text it produces remains a witness, not canonical dictionary data."}, {"id": "bt_witness_prep_package", "label": "wyrdcraeft.services.ocr.bt_witness_prep", "file_type": "code", "source_file": "docs/adr/0006-bt-jp2-witness-preparation-is-library-first.md", "source_location": "L21-L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The package was the in-repo JP2 preparation slice; ADR 0007 later removes wyrdcraeft/services/ocr/ including bt_witness_prep."}], "edges": [{"source": "docs_adr_0006_bt_jp2_witness_preparation_is_library_first", "target": "prepare_pages", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0006-bt-jp2-witness-preparation-is-library-first.md", "source_location": "L19-L21", "weight": 1.0}, {"source": "docs_adr_0006_bt_jp2_witness_preparation_is_library_first", "target": "four_tile_geometry", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0006-bt-jp2-witness-preparation-is-library-first.md", "source_location": "L25-L29", "weight": 1.0}, {"source": "docs_adr_0006_bt_jp2_witness_preparation_is_library_first", "target": "bt_witness_prep_package", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0006-bt-jp2-witness-preparation-is-library-first.md", "source_location": "L21-L22", "weight": 1.0}, {"source": "prepare_pages", "target": "ia_jp2_scans", "relation": "reads", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0006-bt-jp2-witness-preparation-is-library-first.md", "source_location": "L13-L14", "weight": 1.0}, {"source": "prepare_pages", "target": "bt_witness_prep_package", "relation": "part_of", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0006-bt-jp2-witness-preparation-is-library-first.md", "source_location": "L19-L22", "weight": 1.0}, {"source": "docs_adr_0006_bt_jp2_witness_preparation_is_library_first", "target": "docs_adr_0005_bt_source_acquisition_uses_multi_witness_download_set", "re