{"nodes": [{"id": "doc_source_overview_format", "label": "Standard JSON Representation for Old English Texts", "file_type": "document", "source_file": "doc/source/overview/format.rst", "source_location": "L1-L325", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hierarchical JSON schema separates bibliographic metadata, numbering, and speaker labels from Old English text so prose, verse, and dialogue can be imported into translation software without mixing structure into content."}, {"id": "old_english_text", "label": "OldEnglishText", "file_type": "concept", "source_file": "doc/source/overview/format.rst", "source_location": "L182", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OldEnglishText is the top-level Pydantic model combining bibliographic metadata and the content tree so emitted JSON stays schema-valid."}, {"id": "section_model", "label": "Section", "file_type": "concept", "source_file": "doc/source/overview/format.rst", "source_location": "L176-L178", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recursive Section.sections allow books, chapters, and verse sections to nest, and a section may hold both paragraphs and lines so mixed prose and verse stay in one unit."}, {"id": "paragraph_model", "label": "Paragraph", "file_type": "concept", "source_file": "doc/source/overview/format.rst", "source_location": "L180", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An optional speaker marks dialogue turns without putting the speaker name into the Old English text."}, {"id": "sentence_model", "label": "Sentence", "file_type": "concept", "source_file": "doc/source/overview/format.rst", "source_location": "L181", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sentence number and source_page stay off the text field so verse numbers and folio markers remain traceable metadata."}, {"id": "line_model", "label": "Line", "file_type": "concept", "source_file": "doc/source/overview/format.rst", "source_location": "L181", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "anglo_saxon_chronicle", "label": "Anglo-Saxon Chronicle", "file_type": "concept", "source_file": "doc/source/overview/format.rst", "source_location": "L208-L223", "source_url": "https://en.wikisource.org/wiki/Anglo-Saxon_Chronicle_(A)", "captured_at": null, "author": null, "contributor": null, "rationale": "Each annal year is a section number so chronological headings stay out of the prose, including the verse Battle of Brunanburh under year 937."}, {"id": "beowulf_wyatt", "label": "Beowulf (Wyatt 1894)", "file_type": "concept", "source_file": "doc/source/overview/format.rst", "source_location": "L224-L242", "source_url": "https://en.wikisource.org/wiki/Beowulf_(Wyatt)", "captured_at": null, "author": "A. J. Wyatt", "contributor": null, "rationale": "Editorial fitts and every-fifth-line numbers expand to sequential line objects, and manuscript folio markers such as Fol. 129a become source_page rather than text."}, {"id": "solomon_and_saturn", "label": "Solomon and Saturn", "file_type": "concept", "source_file": "doc/source/overview/format.rst", "source_location": "L243-L259", "source_url": "https://sacred-texts.com/neu/ascp/a13.htm", "captured_at": null, "author": null, "contributor": null, "rationale": "Alternating Saturnus and Salomon speeches are speaker-tagged paragraphs or line groups so dialogue structure is preserved."}, {"id": "west_saxon_gospels", "label": "West-Saxon Gospel of Mark", "file_type": "concept", "source_file": "doc/source/overview/format.rst", "source_location": "L260-L284", "source_url": "https://en.wikisource.org/wiki/The_Gospel_of_Saint_Mark_in_West-Saxon", "captured_at": null, "author": "James W. Bright", "contributor": null, "rationale": "Chapters are sections and verses are numbered sentences; quoted speech stays inside narrative paragraphs rather than dramatic turns."}, {"id": "aelfric_lives_of_saints", "label": "Aelfric's Lives of Saints", "file_type": "concept", "source_file": "doc/source/overview/format.rst", "source_location": "L285-L303", "source_url": null, "captured_at": null, "author": "Walter W. Skeat", "contributor": null, "rationale": "Each saint's life is a section, and a converted text must already be filtered to Old English because the edition prints a facing modern translation."}, {"id": "exeter_book_poems", "label": "Exeter Book short poems", "file_type": "concept", "source_file": "doc/source/overview/format.rst", "source_location": "L304-L317", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Poems such as The Wanderer and Deor are a single section of line objects so the schema also covers texts with no chapters or dialogue."}, {"id": "api_models_doc", "label": "api_models schema models", "file_type": "document", "source_file": "doc/source/overview/format.rst", "source_location": "L170", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "doc_source_overview_format", "target": "old_english_text", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/source/overview/format.rst", "source_location": "L182", "weight": 1.0}, {"source": "old_english_text", "target": "section_model", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/source/overview/format.rst", "source_location": "L176-L182", "weight": 1.0}, {"source": "section_model", "target": "paragraph_model", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/source/overview/format.rst", "source_location": "L178-L180", "weight": 1.0}, {"source": "paragraph_model", "target": "sentence_model", "relation": "contains", "confidence": "EXTRACTED", "confidence_sc