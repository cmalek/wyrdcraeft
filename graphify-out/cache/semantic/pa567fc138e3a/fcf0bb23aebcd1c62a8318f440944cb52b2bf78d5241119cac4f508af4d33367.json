{"nodes": [{"id": "docs_superpowers_handoffs_2026_07_03_lexicon_slice1_session_state", "label": "Lexicon SQLAlchemy slice 1 session state (2026-07-03)", "file_type": "document", "source_file": "docs/superpowers/handoffs/2026-07-03-lexicon-slice1-session-state.md", "source_location": null, "source_url": null, "captured_at": "2026-07-03", "author": null, "contributor": null, "rationale": "Alembic owns lexicon DDL so users rarely need lexicon build for schema changes; additive DDL may backfill in a migration, and alembic_version replaces SCHEMA_VERSION as the DDL truth. Rebuild still truncates lexicon_* rows in place when data drifts or read-model logic changes, and it must not drop tables or use sqlite3.connect or TEMP staging. Slice 1 is committed; Slice 2 (NormalizedTitleJoinIndex) had not started."}, {"id": "lexicon_sqlalchemy_core_rebuild", "label": "Lexicon SQLAlchemy Core rebuild", "file_type": "concept", "source_file": "docs/superpowers/handoffs/2026-07-03-lexicon-slice1-session-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slice 1 moved lexicon rebuild to SQLAlchemy Core only: engine.begin and batched insert, delete, select, and update. create_lexicon_tables was removed so DDL is Alembic-only. lexicon build truncates with DELETE FROM lexicon_* and requires Alembic-managed tables. SCHEMA_VERSION was removed from staleness, build metadata, BuildReport, and LexiconBuildMeta. _select_entry_id was kept for Slice 2."}, {"id": "normalized_title_join_index", "label": "NormalizedTitleJoinIndex", "file_type": "code", "source_file": "docs/superpowers/handoffs/2026-07-03-lexicon-slice1-session-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slice 2 was not started. It is planned to add resolve_one and resolve_all, wire BTQueryService and the lexicon form stream, and delete _select_entry_id and _resolve_entry_ids_by_normalized_title."}, {"id": "docs_superpowers_plans_2026_07_03_lexicon_sqlalchemy_normalized_title_join", "label": "Plan: lexicon SQLAlchemy normalized-title join", "file_type": "document", "source_file": "docs/superpowers/handoffs/2026-07-03-lexicon-slice1-session-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parent plan for the lexicon SQLAlchemy migration. Slice 1 of that plan is done; Slice 2 wiring of NormalizedTitleJoinIndex is the next action."}, {"id": "alembic_initial_canonical_schema", "label": "Alembic initial canonical schema 20260630_01", "file_type": "code", "source_file": "docs/superpowers/handoffs/2026-07-03-lexicon-slice1-session-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lexicon table DDL lives in the initial Alembic revision and is applied by upgrade_canonical_db and startup migrations. Rebuild no longer creates those tables."}], "edges": [{"source": "docs_superpowers_handoffs_2026_07_03_lexicon_slice1_session_state", "target": "lexicon_sqlalchemy_core_rebuild", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/handoffs/2026-07-03-lexicon-slice1-session-state.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_handoffs_2026_07_03_lexicon_slice1_session_state", "target": "normalized_title_join_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/handoffs/2026-07-03-lexicon-slice1-session-state.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_handoffs_2026_07_03_lexicon_slice1_session_state", "target": "docs_superpowers_plans_2026_07_03_lexicon_sqlalchemy_normalized_title_join", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/handoffs/2026-07-03-lexic