{"nodes": [{"id": "ref_0002_reconstruction_glossary", "label": "Reference: Reconstruction Glossary", "file_type": "document", "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimum vocabulary for reading historical-linguistics explanations without getting buried."}, {"id": "umlaut", "label": "Umlaut / mutation", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Umlaut / mutation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A later sound change in which one vowel is altered because of a vowel or glide in the next syllable. Distinct from ablaut, which is an older inherited alternation not caused by a neighbor in the current form."}, {"id": "ablaut", "label": "Ablaut", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Ablaut", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inherited vowel alternation inside a word-family or paradigm, not caused by a neighboring sound in the current form. Grades include e-grade, o-grade, and zero-grade. f\u014dt ~ f\u0113t shows inherited ablaut underneath and later i-umlaut in the plural."}, {"id": "analogy", "label": "Analogy", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Analogy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reshaping by pattern pressure rather than direct sound law. It can hide older phonological history by smoothing paradigms. Leveling is the kind of analogy that reduces differences inside a paradigm."}, {"id": "comparative_method", "label": "Comparative method", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Comparative method", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main method for reconstructing an unattested ancestor: compare related languages, find recurring correspondences, and infer the earlier form that best explains them. Reconstruction is constrained hypothesis, which is why forms wear an asterisk."}, {"id": "internal_reconstruction", "label": "Internal reconstruction", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Internal reconstruction", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Using irregularities inside one language to infer an earlier stage of that same language."}, {"id": "reconstructed_form", "label": "Reconstructed form", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Reconstructed form", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A form not directly attested, inferred from evidence, and written with an asterisk, like *f\u014dtiz. The asterisk marks constrained hypothesis rather than free invention."}, {"id": "reflex", "label": "Reflex", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Reflex", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A later form descended from an earlier one. Old English f\u014dt is a reflex of an earlier Germanic form, and Modern English foot is a reflex of Old English f\u014dt."}, {"id": "cognate", "label": "Cognate", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Cognate", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A related word inherited from a shared ancestor, not merely a similar-looking word."}, {"id": "sound_correspondence", "label": "Sound correspondence", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Sound correspondence", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A recurring match across related languages, such as English f corresponding to Latin p, used as evidence for a regular earlier change."}, {"id": "sound_law", "label": "Sound law", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Sound law", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A regular sound change applying across a class of forms under stated conditions. Order is inferred from dependency: what a later change operates on must already exist."}], "edges": [{"source": "ref_0002_reconstruction_glossary", "target": "oe_historical_grammar_course", "relation": "part_of", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": null, "weight": 0.95}, {"source": "ablaut", "target": "umlaut", "relation": "contrasts_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Quick contrast", "weight": 1.0}, {"source": "ref_0002_reconstruction_glossary", "target": "reconstructed_form", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Reconstructed form", "weight": 1.0}, {"source": "ref_0002_reconstruction_glossary", "target": "reflex", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Reflex", "weight": 1.0}, {"source": "ref_0002_reconstruction_glossary", "target": "cognate", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Cognate", "weight": 1.0}, {"source": "ref_0002_reconstruction_glossary", "target": "sound_correspondence", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Sound correspondence", "weight": 1.0}, {"source": "ref_0002_reconstruction_glossary", "target": "comparative_method", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Comparative method", "weight": 1.0}, {"source": "ref_0002_reconstruction_glossary", "target": "internal_reconstruction", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Internal reconstruction", "weight": 1.0}, {"source": "ref_0002_reconstruction_glossary", "target": "ablaut", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Ablaut", "weight": 1.0}, {"source": "ref_0002_reconstruction_glossary", "target": "umlaut", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0002-reconstruction-glossary.html", "source_location": "Umlaut / mutation", "weight": 1.0}, {"source": "ref_0002_reconstruction_glossary", "target": "analogy", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teach