{"nodes": [{"id": "lesson_0006_bt_entry_structuring", "label": "Lesson 0006: BT Entry Structuring From Witnesses", "file_type": "document", "source_file": "teaching/machine-assistance/lessons/0006-bt-entry-structuring-from-witnesses.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Go from a Bosworth-Toller OCR witness page to structured dictionary entries without flattening the evidence that makes an entry trustworthy."}, {"id": "machine_assistance_course", "label": "Machine-assistance course", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0006-bt-entry-structuring-from-witnesses.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Teaching sequence for turning difficult Old English page images into inspectable structured data."}, {"id": "entry_block", "label": "Entry block", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0006-bt-entry-structuring-from-witnesses.html", "source_location": "1. The Unit Of Work Is The Entry", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Page OCR is only the witness layer. The useful unit is one headword plus its variants, grammar, glosses, attestations, citations, derivations, and editorial material, because asking how to turn a whole page into final rows flattens entry boundaries."}, {"id": "lossless_raw_entry", "label": "Lossless raw entry representation", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0006-bt-entry-structuring-from-witnesses.html", "source_location": "3. First Goal: A Lossless Raw Entry", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preserve order and provenance before a final dictionary schema so nothing is lost just because the parser does not yet fully understand it."}, {"id": "raw_entry_fragment_types", "label": "Raw entry fragment types", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0006-bt-entry-structuring-from-witnesses.html", "source_location": "3. First Goal: A Lossless Raw Entry", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fragment kinds are headword, variant, grammar, sense, translation_en, translation_la, attestation, source_citation, editorial_note, derivation, and unclassified_remainder. The unclassified remainder exists so uncertain text is kept rather than forced into a wrong field."}, {"id": "dictionary_entry_schema", "label": "Pydantic DictionaryEntry schema", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0006-bt-entry-structuring-from-witnesses.html", "source_location": "5. A Raw Entry Schema", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A permissive evidence-friendly schema (Citation, Sense, RawFragment, DictionaryEntry) is stable enough for code, broad enough for partial parses, and explicit about what the parser does not yet know."}, {"id": "abbad_entry", "label": "abbad worked entry", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0006-bt-entry-structuring-from-witnesses.html", "source_location": "4. Worked Example: abbad", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The abbad block shows layered headword, variants abbod/abbud/abbot, grammar, senses I and II, Latin abb\u0101s, citations, editorial prose, and DER. forms, so a structured draft can be emitted while raw fragments remain."}, {"id": "bt_gold_annotation", "label": "BT gold annotation layers", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0006-bt-entry-structuring-from-witnesses.html", "source_location": "7. What To Gold By Hand", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gold for Bosworth-Toller should be at entry-structure level: page witness correction, entry boundaries, then hand-labeled fragments for 5\u201310 entries such as abbad, abbadisse, and abbod-r\u00edce, so boundary, headword, variant, grammar, and citation accuracy can be measured."}, {"id": "deterministic_then_ai_parsing", "label": "Deterministic-first, AI-second parsing", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0006-bt-entry-structuring-from-witnesses.html", "source_location": "8. Parsing Strategy: Deterministic First, AI Second", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic cues (headword-like line starts, es; m. / an; f., I./II./DER., citation abbreviations, em dash or colon) should yield a safe partial parse with leftovers. AI should classify residue and suggest repairs, not replace the base parser. PydanticAI is later scaffolding; explicit schemas plus gold examples are the foundation."}, {"id": "pydantic", "label": "pydantic", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0006-bt-entry-structuring-from-witnesses.html", "source_location": "9. Where Pydantic Helps", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used for a stable schema, validation of partial parses, optional versus required fields, and JSON export for review or downstream agents."}, {"id": "bt_page_0030_image", "label": "anglosaxondictio00bosw-0030.png", "file_type": "image", "source_file": "teaching/machine-assistance/lessons/0006-bt-entry-structuring-from-witnesses.html", "source_location": "2. The Witness We Start From", "source_url": "/Users/cmalek/src/workspace/wyrdcraeft/data/sources/raw/bosworth_toller/pages/anglosaxondictio00bosw-0030.png", "captured_at": null, "author": null, "contributor": null, "rationale": "Source page image for the lesson; new entries begin with a bold-like headword shape at the start of a line in the page image."}, {"id": "bt_page_0030_witness", "label": "anglosaxondictio00bosw-0030.md OCR witness", "file_type": "document", "source_file": "teaching/machine-assistance/lessons/0006-bt-entry-structuring-from-witnesses.html", "source_location": "2. The Witness We Start From", "source_url": "/Users/cmalek/src/workspace/wyrdcraeft/data/sources/raw/bosworth_toller/witnesses/pages/anglosaxondictio00bosw-0030.md", "captured_at": null, "author": null, "contributor": null, "rationale": "Reassembled OCR witness already preserves variant spellings inline and mixes grammar, Latin glosses, definitions, and attestations in one block rather than clean columns."}, {"id": "lesson_0004_lossless_ocr_pipeline", "label": "Lesson 0004: Lossless OCR Pipeline for Difficult PDFs", "file_type": "document", "source_file": "teaching/machine-assistance/lessons/0006-bt-entry-structuring-from-witnesses.html", "source_location": "11. Keep Nearby", "source_url": "./0004-lossless-ocr-pipeline.html", "captured_at": null, "author": null, "contributor": null, "rationale": "Kept nearby because entry structuring assumes a lossless witness pipeline rather than cleaned text with no provenance."}, {"id": "lesson_0005_input_quality", "label": "Lesson 0005: Input Quality and Page Preparation", "file_type": "document", "source_file": "teaching/machine-assistance/lessons/0006-bt-entry-structuring-from-witnesses.html", "source_location": "11. Keep Nearby", "source_url": "./0005-input-quality-and-page-preparation.html", "captured_at": null, "author": null, "contributor": null, "rationale": "Kept nearby because the Bosworth-Toller witness is built from a page image split into column tiles."}], "edges": [{"source": "lesson_0006_bt_entry_structuring", "target": "machine_assistance_course", "relation": "part_of", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "teaching/machine-assistance/lessons/0006-bt-entry-structuring-from-witnesses.html", "source_location": null, "weight": 0.95