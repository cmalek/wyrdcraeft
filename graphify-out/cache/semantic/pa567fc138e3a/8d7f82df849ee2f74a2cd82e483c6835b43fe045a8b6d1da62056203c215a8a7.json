{"nodes": [{"id": "ref_0006_ocr_output_formats", "label": "Reference 0006: OCR Output Formats", "file_type": "document", "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain text is for reading; hOCR, TSV, ALTO, and PAGE XML keep layout, coordinates, structure, and confidence attached to the recognized text."}, {"id": "character_error_rate", "label": "Character Error Rate (CER)", "file_type": "concept", "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "Common OCR Quality Metrics", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Share of characters inserted, deleted, or substituted to match a reference. For Old English, CER is usually more informative than WER because one wrong character can change morphology, script, or diacritics. A decent CER can still hide table collapse or lost italics."}, {"id": "word_error_rate", "label": "Word Error Rate (WER)", "file_type": "concept", "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "Common OCR Quality Metrics", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coarser readability check. Less sensitive than CER to single-character damage inside a word, which matters in philological work."}, {"id": "hocr", "label": "hOCR", "file_type": "concept", "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "hOCR", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HTML/XHTML OCR format that can carry bounding boxes, line and page structure, and confidence. Chosen when the output should be human-inspectable in a browser. Less tidy for strict downstream pipelines."}, {"id": "ocr_tsv", "label": "OCR TSV", "file_type": "concept", "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "TSV", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tab-separated rows per page, block, paragraph, line, or word, with text, confidence, and coordinates. Fastest low-friction format for scripting; lighter structure than the XML formats."}, {"id": "alto", "label": "ALTO", "file_type": "concept", "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "ALTO", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "XML standard for pages, regions, lines, strings, coordinates, and metadata in library and archive workflows. More verbose and heavier to parse; used as archive-grade interchange."}, {"id": "page_xml", "label": "PAGE XML", "file_type": "concept", "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "PAGE XML", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "XML standard strong at page regions, text lines, segmentation, and reading order. Used when layout structure itself is part of the problem."}, {"id": "ocr_layout_evidence", "label": "OCR layout evidence", "file_type": "concept", "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "Practical Caution", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "These formats do not solve OCR quality. They keep evidence about where the text came from and how it was segmented, which matters when plain text looks plausible but layout, reading order, or symbol handling is wrong."}, {"id": "tesseract_faq", "label": "Tesseract FAQ", "file_type": "paper", "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "Sources Used", "source_url": "https://tesseract-ocr.github.io/tessdoc/FAQ.html", "captured_at": null, "author": null, "contributor": null, "rationale": "Cited for what Tesseract output formats and common OCR behavior actually are."}, {"id": "tesseract_manual", "label": "Tesseract manual page", "file_type": "paper", "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "Sources Used", "source_url": "https://github.com/tesseract-ocr/tesseract/blob/main/doc/tesseract.1.asc", "captured_at": null, "author": null, "contributor": null, "rationale": "Cited alongside the FAQ as a source for Tesseract output options."}], "edges": [{"source": "ref_0006_ocr_output_formats", "target": "machine_assistance_course", "relation": "part_of", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": null, "weight": 0.95}, {"source": "ref_0006_ocr_output_formats", "target": "hocr", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "hOCR", "weight": 1.0}, {"source": "ref_0006_ocr_output_formats", "target": "ocr_tsv", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "TSV", "weight": 1.0}, {"source": "ref_0006_ocr_output_formats", "target": "alto", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "ALTO", "weight": 1.0}, {"source": "ref_0006_ocr_output_formats", "target": "page_xml", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "PAGE XML", "weight": 1.0},