r_output_formats", "target": "lesson_0004_lossless_ocr_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "Keep Nearby", "weight": 1.0}, {"source": "ref_0006_ocr_output_formats", "target": "tesseract_faq", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "Sources Used", "weight": 1.0}, {"source": "ref_0006_ocr_output_formats", "target": "tesseract_manual", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "Sources Used", "weight": 1.0}, {"source": "ref_0006_ocr_output_formats", "target": "ocr_d_workflow_guide", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/reference/0006-ocr-output-formats.html", "source_location": "Sources Used", "weight": 1.0}], "hyperedges": []}