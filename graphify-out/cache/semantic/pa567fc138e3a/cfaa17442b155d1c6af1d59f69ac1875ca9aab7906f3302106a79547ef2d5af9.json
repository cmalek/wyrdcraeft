{"nodes": [{"id": "morph_class_browse_audit_design", "label": "Morph class browse and audit design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-04-morph-class-browse-audit-design.md", "source_location": "L1-L204", "source_url": null, "captured_at": "2026-07-04", "author": null, "contributor": null, "rationale": "Source wright fields are too incomplete and noisy to be canonical truth. Primary truth is a deterministic morph class per lemma and part of speech; Wright sections are class-linked citations."}, {"id": "lemma_morph_classes", "label": "lemma_morph_classes", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-04-morph-class-browse-audit-design.md", "source_location": "L31-L75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canonical lemma classification layer keyed by (normalized_title, pos) to morph_class_id. Classification is per POS bucket, not headword-wide."}, {"id": "morph_classes", "label": "morph_classes", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-04-morph-class-browse-audit-design.md", "source_location": "L33-L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carries the modern scholarly label users see, including canonical_name, modern_class, and traditional_class."}, {"id": "wright_sections", "label": "wright_sections", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-04-morph-class-browse-audit-design.md", "source_location": "L35-L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supporting citations attached to a class. section_text is ingested for inline inspection and is not required to classify a lemma."}, {"id": "morphology_catalog_query_service", "label": "MorphologyCatalogQueryService", "file_type": "code", "source_file": "docs/superpowers/specs/2026-07-04-morph-class-browse-audit-design.md", "source_locati