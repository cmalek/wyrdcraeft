{"nodes": [{"id": "lexicon_browse_orchestration", "label": "Lexicon browse orchestration", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-28-lexicon-browse/ORCHESTRATION.md", "source_location": "L1-L528", "source_url": null, "captured_at": "2026-06-28", "author": null, "contributor": null, "rationale": "Chat history is not the system of record. An orchestrator dispatches one phase subagent at a time and does not implement product code."}, {"id": "morphology_sqlite3", "label": "morphology.sqlite3", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-28-lexicon-browse/ORCHESTRATION.md", "source_location": "L25-L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At browse-v1 lock time this file is the canonical working lexicon database holding forms, curated bt_* tables, and derived lexicon_* tables."}, {"id": "lexicon_star_tables", "label": "lexicon_* tables", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-28-lexicon-browse/ORCHESTRATION.md", "source_location": "L29-L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lexicon build rebuilds only lexicon_* from existing forms and bt_*; it does not regenerate Bosworth-Toller data."}, {"id": "bt_star_tables", "label": "bt_* tables", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-28-lexicon-browse/ORCHESTRATION.md", "source_location": "L28-L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Curated Bosworth-Toller tables live in the working database and are bootstrapped by dictionary attach/index flows, not by lexicon build."}, {"id": "forms_table", "label": "forms table", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-28-lexicon-browse/ORCHESTRATION.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live morphology rows are a lexicon-build input and must not be modified by the lexicon builder."}, {"id": "lexicon_build_command", "label": "wyrdcraeft lexicon build", "file_type": "code", "source_file": "docs/superpowers/specs/2026-06-28-lexicon-browse/ORCHESTRATION.md", "source_location": "L41-L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User-facing rebuild of derived browse tables only."}, {"id": "lexicon_browse_command", "label": "wyrdcraeft lexicon browse", "file_type": "code", "source_file": "docs/superpowers/specs/2026-06-28-lexicon-browse/ORCHESTRATION.md", "source_location": "L41-L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TUI v1 is browse only: no editing UI and no provenance editing UI. One search box; morphology-only matches stay in a separate orphan section."}, {"id": "lexicon_entries", "label": "lexicon_entries", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-28-lexicon-browse/ORCHESTRATION.md", "source_location": "L317-L324", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per real dictionary entry so main results are entries, not spellings."}, {"id": "lexicon_search_keys", "label": "lexicon_search_keys", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-28-lexicon-browse/ORCHESTRATION.md", "source_location": "L318-L326", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Powers bare, normalized, and full-form search and ranking."}, {"id": "lexicon_forms", "label": "lexicon_forms", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-28-lexicon-browse/ORCHESTRATION.md", "source_location": "L319-L325", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "May include morphology rows with no matching dictionary entry; those rows are orphans."}, {"id": "lexicon_build_meta", "label": "lexicon_build_meta", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-28-lexicon-browse/ORCHESTRATION.md", "source_location": "L320", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds build metadata so staleness can be shown without a separate lexicon database."}, {"id": "orphan_morphology_section", "label": "Orphan morphology section", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-28-lexicon-browse/ORCHESTRATION.md", "source_location": "L52-L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main results show only real dictionary entries; morphology-only matches stay visible in a separate section."}, {"id": "lexicon_query_service", "label": "Lexicon query service", "file_type": "code", "source_file": "docs/superpowers/specs/2026-06-28-lexicon-browse/ORCHESTRATION.md", "source_location": "L361-L390", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unified search ranking is locked: exact dictionary hits, then joined morphology lemma/stem, then joined forms, then orphans."}, {"id": "lexicon_phase_08", "label": "Lexicon browse phase 08", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-28-lexicon-browse/ORCHESTRATION.md", "source_location": "L493-L528", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Core dictionary or morphology edits are optional and blocked until a human approves them; phases 01-07 are the definition of done."}], "edges": [{"source": "lexicon_browse_orchestration", "target": "morphology_sqlite3", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-28-lexicon-browse/ORCHESTRATION.md", "source_location": "L43", "weight": 1.0}, {"source": "morphology_sqlite3", "target": "forms_table", "relation": "contains", "conf