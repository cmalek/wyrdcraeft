{"nodes": [{"id": "context", "label": "wyrdcraeft Context", "file_type": "document", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_wyrdcraeft", "label": "wyrdcraeft", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python toolkit for Old English source processing: ingest to document JSON, diacritics, morphology, and Bosworth-Toller dictionary workflows."}, {"id": "context_oe_text_processing_boundary", "label": "Old English Product Boundary", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The repo is Old English text-processing only. General NLP, OCR, and LLM messy-document ingest moved to wordwending, formerly bochord, per ADR 0007 and ADR 0010."}, {"id": "context_wordwending", "label": "wordwending", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sibling repo that now holds the OCR pipeline; formerly called bochord, renamed because GitHub already had bochord."}, {"id": "context_document_ingestor", "label": "DocumentIngestor", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_diacritic_restorer", "label": "DiacriticRestorer", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_canonical_database", "label": "Canonical wyrdcraeft.sqlite3", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One app-data SQLite file holds morphology forms, attached bt_* dictionary tables, and the Wright morph catalog."}, {"id": "context_macron_index", "label": "Macron Index", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_diacritic_marking", "label": "Diacritic Marking", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marking is strictly additive: macrons and palatal dots may be added, but source characters, eth/thorn, case, and hyphenation are never removed or replaced."}, {"id": "context_diacritic_transfer", "label": "Diacritic Transfer", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marks are copied from a macron-index display form onto the matching source letters; the index form never replaces the source token."}, {"id": "context_collapsing_ambiguity", "label": "Collapsing Ambiguity", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An ambiguous key whose options share one mark pattern is applied like a unique entry and not reported as ambiguous, unless the key is completed."}, {"id": "context_completed_ambiguous_key", "label": "Completed Ambiguous Key", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A completed key stays in ambiguous, is listed in ambiguous_completed, and is excluded from the default disambiguate queue. Completion does not require POS or meaning annotations, and mark-diacritics never guesses it."}, {"id": "context_macron_index_curation", "label": "Macron-Index Curation", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Curation mutates the macron index JSON. This section says completion means every attested form has at least one POS/meaning sense, and that restoration only reads the index."}, {"id": "context_ambiguity_policy", "label": "Ambiguity Policy", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mark-diacritics treats a non-collapsing ambiguous key with auto, leave, or union; a guessed token stays in the ambiguity report with the form written and the policy."}, {"id": "context_standard_element", "label": "Standard Element", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hand-edited prefix or compound element with one editorial spelling, applied to index forms only where Bosworth-Toller writes a hyphen next to it."}, {"id": "context_variant_import", "label": "Variant Import", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bosworth-Toller variant spellings are added to the macron index as their own entries; existing keys are never changed."}, {"id": "context_sc_exception", "label": "sc Palatal Exception", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A c immediately preceded by s never receives a palatal dot. This overrides the forced-palatalize list, but a c-dot already in the source is kept."}, {"id": "context_mark_pattern", "label": "Mark Pattern", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_morphology_not_perl_parity", "label": "Morphology Generation Correctness", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inflected output is judged by product tests and Old English grammar, not by matching Tich\u00fd create_dict31.pl. Python snapshots are regression locks. See ADR 0012."}, {"id": "context_verb_generation_engines", "label": "Verb Generation Engines", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VerbFormGenerator routes; StrongVerbGenerator is the ablaut engine; WeakVerbGenerator covers Weak I/II plus Weak III, preterite-present, and anomalous. These are engines, not Wright conjugation classes. See ADR 0011."}, {"id": "context_editorial_operation", "label": "Editorial Operation", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_edit_record", "label": "Edit Record", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audit of one editorial operation applied or skipped during consolidation. The merger class is not the audit type, and the canonical import is wyrdcraeft.models.dictionary. See ADR 0021."}, {"id": "context_index_population_gate", "label": "Index Population Gate", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "dictionary query requires bt_* tables that contain rows. Startup readiness only guarantees schema, so empty tables are valid for build and invalid for query. See ADR 0013."}, {"id": "context_startup_database_readiness", "label": "Startup Database Readiness", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Startup must ensure canonical wyrdcraeft.sqlite3 exists at the expected schema before any database command. Schema-ready is not the same as populated."}, {"id": "context_normalized_title", "label": "normalized_title", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Macron- and dot-preserving lemma title used to join forms with bt_entries and bt_variants. Distinct from norm_key, which strips combining marks."}, {"id": "context_norm_key", "label": "norm_key", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_sense_path", "label": "Sense Path", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Machine-only hierarchical sense id such as 1 or 1.2. Literal Bosworth-Toller labels like I. or IVa. stay in source_label_raw for provenance only."}, {"id": "context_dictionary_source_block", "label": "Dictionary Source Block", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One contiguous Bosworth-Toller headword entry in source order is the canonical identity of one bt_entries row. Homographs stay separate blocks."}, {"id": "context_dictionary_browse_search", "label": "Dictionary Browse Search", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Twelve-tier headword and variant ranking in DictionaryBrowseQueryService over bt_entries and bt_variants, with no derived search-index tables. The TUI does not own SQL."}, {"id": "context_forms_entry_relinker", "label": "FormsEntryRelinker", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_wright_morph_catalog", "label": "Wright Morph Catalog", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_wright_1925", "label": "Wright 1925 Old English Grammar", "file_type": "paper", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_lossless_source_grounded_ast", "label": "Lossless Source-Grounded AST", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First-pass Bosworth-Toller parse that preserves source order, source text, and fragment boundaries before normalization."}, {"id": "context_bt_index_pipeline", "label": "BTIndexPipeline", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_dictionary_build_pipeline", "label": "DictionaryBuildPipeline", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_adr_0007", "label": "ADR 0007 OCR Pipeline Moves Out", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OCR pipeline leaves this repo. The sibling was bochord and is now wordwending."}, {"id": "context_adr_0010", "label": "ADR 0010 LLM Leaves Source Convert", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_adr_0011", "label": "ADR 0011 Verb Generators Leave common.py", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "File split only. Strong, Weak, and the orchestrator are engines, not Old English conjugation classes."}, {"id": "context_adr_0012", "label": "ADR 0012 Not Perl-Parity-Bound", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_adr_0013", "label": "ADR 0013 Index Population Gate", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_adr_0014", "label": "ADR 0014 Browse TUI Is a Shell", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The browse TUI must not touch SQLAlchemy. Query owns SQL, ranking, and bt_entries readiness."}, {"id": "context_adr_0015", "label": "ADR 0015 Additive Diacritic Transfer", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "source mark-diacritics is additive transfer, not replacement of the source token."}, {"id": "context_adr_0016", "label": "ADR 0016 Macron Index Variants Are Own Entries", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Amends ADR 0015. Variants are their own index entries and the packaged macron index is repaired, not regenerated."}, {"id": "context_adr_0017", "label": "ADR 0017 Import BT Variants", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CONTEXT marks this ADR proposed and not implemented: the diacritic CLI would import Bosworth-Toller variants as their own index entries."}, {"id": "context_adr_0018", "label": "ADR 0018 Warn On Non-Normalizing Forms", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CONTEXT marks this ADR proposed and not implemented: diacritic write commands should warn when a form does not match its key."}, {"id": "context_adr_0019", "label": "ADR 0019 Ambiguity Policy", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CONTEXT marks this ADR proposed and not implemented: ambiguity is judged on marks and resolved by a policy."}, {"id": "context_adr_0020", "label": "ADR 0020 Diphthong As One Unit", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CONTEXT marks this ADR proposed and not implemented, split out of ADR 0015: DiacriticTransfer treats a diphthong as one unit."}, {"id": "context_adr_0021", "label": "ADR 0021 Edit Records With Dictionary Models", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The editorial merger stays a facad