{"nodes": [{"id": "bt_variant_stoplist", "label": "Bosworth-Toller variant stoplist", "file_type": "document", "source_file": "wyrdcraeft/etc/diacritic/bt_variant_stoplist.txt", "source_location": "L1-L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Citation sigla and Roman numerals inside Bosworth-Toller entries are not Old English words. The importer already rejects a key listed as a variant under three or more headwords; this list catches the rest, and everything on a source too small for that rule. Matching ignores case."}, {"id": "adr_0017", "label": "ADR 0017", "file_type": "document", "source_file": "wyrdcraeft/etc/diacritic/bt_variant_stoplist.txt", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cited as the decision that citation sigla and Roman numerals in Bosworth-Toller entries are not Old English words and belong on the variant stoplist."}, {"id": "bt_stoplist_odd_tokens", "label": "Non-sigla tokens on the BT stoplist", "file_type": "concept", "source_file": "wyrdcraeft/etc/diacritic/bt_variant_stoplist.txt", "source_location": "L42-L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "flows, there, heel, boot, ll, mean, lies, and penned are listed beside citation sigla and Roman numerals. The file says the list catches non-Old-English keys, but it does not say why these particular English-looking tokens are included."}], "edges": [{"source": "bt_variant_stoplist", "target": "adr_0017", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "wyrdcraeft/etc/diacritic/bt_variant_stoplist.txt", "source_location": "L1", "weight": 1.0}, {"source": "bt_variant_stoplist", "target": "bosworth_toller", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "wyrdcraeft/etc/diacritic/bt_variant_stoplist.txt", "source_location": "L