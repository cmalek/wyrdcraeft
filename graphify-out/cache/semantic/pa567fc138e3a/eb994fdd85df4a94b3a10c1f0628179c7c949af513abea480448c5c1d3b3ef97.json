{"nodes": [{"id": "docs_adr_0009_morphology_generation_class_refactor", "label": "Collapse morphology generation callback-soup into PoS generator classes", "file_type": "document", "source_file": "docs/adr/0009-morphology-generation-class-refactor.md", "source_location": "L1-L407", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Callback-threaded Perl-port generation is collapsed into one class per part of speech and Strong and Weak verb generators because loose functions and functools.partial chains are not cohesive classes with a thin facade and a dedicated orchestrator. Byte-exact Perl output is superseded by ADR 0012; the class-collapse decision still stands."}, {"id": "adr_0012", "label": "ADR 0012 morphology generation not Perl-parity bound", "file_type": "document", "source_file": "docs/adr/0009-morphology-generation-class-refactor.md", "source_location": "L5-L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Byte-exact Perl output is no longer binding; historically correct fixes may diverge from create_dict31.pl when tests and the quirks ledger are updated."}, {"id": "morphology_generation_facade", "label": "MorphologyGenerationFacade", "file_type": "concept", "source_file": "docs/adr/0009-morphology-generation-class-refactor.md", "source_location": "L148-L205", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The facade stays thin and becomes the sole public generation entrypoint, delegating each method to one part-of-speech generator class."}, {"id": "strong_verb_generator", "label": "StrongVerbGenerator", "file_type": "concept", "source_file": "docs/adr/0009-morphology-generation-class-refactor.md", "source_location": "L245-L261", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strong-verb emission becomes direct methods on one class so principal-part and derivation order is readable without functools.partial callback chains."}, {"id": "weak_verb_generator", "label": "WeakVerbGenerator", "file_type": "concept", "source_file": "docs/adr/0009-morphology-generation-class-refactor.md", "source_location": "L262-L269", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weak, preterite-present, and anomalous paradigms share this engine because those Tichy tables are fully specified item shapes, not a separate generator per Wright class."}, {"id": "adjective_form_generator", "label": "AdjectiveFormGenerator", "file_type": "concept", "source_file": "docs/adr/0009-morphology-generation-class-refactor.md", "source_location": "L207-L220", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One adjective class with a paradigm-dispatch table replaces an elif chain over regexes so paradigm coverage is data rather than control flow."}, {"id": "adverb_form_generator", "label": "AdverbFormGenerator", "file_type": "concept", "source_file": "docs/adr/0009-morphology-generation-class-refactor.md", "source_location": "L210", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "noun_form_generator", "label": "NounFormGenerator", "file_type": "concept", "source_file": "docs/adr/0009-morphology-generation-class-refactor.md", "source_location": "L211", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "numeral_form_generator", "label": "NumeralFormGenerator", "file_type": "concept", "source_file": "docs/adr/0009-morphology-generation-class-refactor.md", "source_location": "L212", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "form_rows", "label": "form_rows shared emission", "file_type": "concept", "source_file": "docs/adr/0009-morphology-generation-class-refactor.md", "source_location": "L90-L99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rati