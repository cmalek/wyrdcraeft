{"nodes": [{"id": "lesson_0004_lossless_ocr", "label": "Lesson 0004 lossless OCR pipeline", "file_type": "document", "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L12-L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OCR produces evidence; structured data produces claims. Evidence should be preserved and claims should point back to evidence."}, {"id": "seven_stage_ocr_pipeline", "label": "Seven-stage OCR pipeline", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L26-L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acquire, prepare, OCR, validate, anchor, adjudicate, then export, so structure is derived only after witnesses and quality checks exist."}, {"id": "raw_ocr_witness", "label": "Raw OCR witness", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What the OCR system said. Collapsing it with corrections or exports removes the ability to audit mistakes and compare runs."}, {"id": "ocr_overlay", "label": "OCR overlay", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What a human or later pass decided to correct. Review by exception records corrections here instead of rewriting the witness."}, {"id": "normalized_export", "label": "Normalized OCR export", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What downstream software or agents should consume, with provenance back to the witness."}, {"id": "review_by_exception", "label": "Review by exception", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L47-L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimal human involvement means the machine does bulk work and humans decide only uncertain spans, damaged characters, broken table order, or claims that outrun the evidence."}, {"id": "philological_ocr_metrics", "label": "Philological OCR metric stack", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L66-L127", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A lower CER can still make text less trustworthy if the system silently normalizes or hallucinates. Measure macrons, ligatures, thorn and eth, Greek, line joins, tables, and style retention separately."}, {"id": "micro_gold", "label": "Micro-gold calibration", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L130-L239", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "True recall needs a gold count. Correct a few representative pages once, set floors from correction burden, then scale with anomaly metrics. Do not gold an entire book first."}, {"id": "wright_and_wright_pdf", "label": "WrightAndWright.pdf", "file_type": "document", "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Document-aware validation example: bold Old English headwords and italic Modern English glosses carry structure, so style retention is part of whether the witness preserved parseable information. Page 26 is the macron micro-gold slice."}], "edges": [{"source": "lesson_0004_lossless_ocr", "target": "seven_stage_ocr_pipeline", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L26-L36", "weight": 1.0}, {"source": "lesson_0004_lossless_ocr", "target": "raw_ocr_witness", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L59", "weight": 1.0}, {"source": "lesson_0004_lossless_ocr", "target": "ocr_overlay", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L60", "weight": 1.0}, {"source": "lesson_0004_lossless_ocr", "target": "normalized_export", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L61", "weight": 1.0}, {"source": "lesson_0004_lossless_ocr", "target": "review_by_exception", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L48", "weight": 1.0}, {"source": "lesson_0004_lossless_ocr", "target": "philological_ocr_metrics", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L66-L127", "weight": 1.0}, {"source": "lesson_0004_lossless_ocr", "target": "micro_gold", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L146", "we