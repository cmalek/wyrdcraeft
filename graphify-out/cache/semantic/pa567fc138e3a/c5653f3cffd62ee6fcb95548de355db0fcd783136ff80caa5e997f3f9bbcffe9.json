relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L30", "weight": 1.0}, {"source": "wright_and_wright_pdf", "target": "wright_md", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L113", "weight": 1.0}], "hyperedges": [{"id": "ocr_evidence_layers", "label": "OCR evidence layers that must stay separate", "nodes": ["raw_ocr_witness", "ocr_overlay", "normalized_export"], "relation": "must_remain_distinct", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/lessons/0004-lossless-ocr-pipeline.html", "source_location": "L57-L64", "weight": 1.0, "rationale": "Collapsing witness, correction, and derived export into one file removes auditability. Claims in the export must point back to evidence."}]}