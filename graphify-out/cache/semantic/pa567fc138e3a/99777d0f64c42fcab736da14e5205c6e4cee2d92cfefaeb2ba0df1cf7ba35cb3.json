{"nodes": [{"id": "lesson_0005_page_preparation", "label": "Lesson 0005 input quality and page preparation", "file_type": "document", "source_file": "teaching/machine-assistance/lessons/0005-input-quality-and-page-preparation.html", "source_location": "L11-L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The cheapest OCR improvement is often a better visual witness. Preprocess only the failure mode you diagnosed, because each transform can help one problem and damage another."}, {"id": "preparation_ladder", "label": "OCR preparation ladder", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0005-input-quality-and-page-preparation.html", "source_location": "L48-L57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Try the least destructive move first: better source, then geometry, then gentle contrast, then region splitting, and aggressive binarization or morphology only when simpler steps fail and metrics show a gain."}, {"id": "bosworth_toller_pdf", "label": "anglosaxondictio00bosw.pdf", "file_type": "document", "source_file": "teaching/machine-assistance/lessons/0005-input-quality-and-page-preparation.html", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dense two-column small type benefits from tiling so each line gets more pixels and diacritics survive, provided reassembly preserves reading order and does not duplicate overlapping text."}, {"id": "two_stage_ocr_pipeline", "label": "Two-stage text and style OCR pipeline", "file_type": "concept", "source_file": "teaching/machine-assistance/lessons/0005-input-quality-and-page-preparation.html", "source_location": "L106-L127", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If typography carries meaning, one model should not be assumed to do both hard-text recognition and style or layou