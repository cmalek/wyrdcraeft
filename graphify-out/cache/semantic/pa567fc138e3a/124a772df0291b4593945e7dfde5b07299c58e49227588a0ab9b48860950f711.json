{"nodes": [{"id": "doc_source_overview_morphology_perl_quirks_ledger", "label": "Morphology Perl Compatibility Quirks Ledger", "file_type": "document", "source_file": "doc/source/overview/morphology_perl_quirks_ledger.rst", "source_location": "L1-L117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tichy Perl is a historical port source, not an oracle, so a historically correct or bugfix change must not be refused solely to preserve these quirks; tests and this ledger are updated in the same change."}, {"id": "create_dict31_pl", "label": "create_dict31.pl", "file_type": "code", "source_file": "doc/source/overview/morphology_perl_quirks_ledger.rst", "source_location": "L4-L5", "source_url": null, "captured_at": null, "author": "Tichy", "contributor": null, "rationale": "The Perl generator is the historical port source for morphology, not an oracle that later bugfixes must match."}, {"id": "print_one_form", "label": "print_one_form", "file_type": "concept", "source_file": "doc/source/overview/morphology_perl_quirks_ledger.rst", "source_location": "L94-L95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Empty probability and literal zero must print differently, and a reduced-form duplicate increments probability, matching Perl output semantics."}, {"id": "enable_r_stem_nouns", "label": "--enable-r-stem-nouns", "file_type": "concept", "source_file": "doc/source/overview/morphology_perl_quirks_ledger.rst", "source_location": "L103-L117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R-stem noun paradigms stay off by default because the flag is an experimental extra, not a Perl-compatibility switch; default-on is allowed later under ADR 0012 if tests are updated."}, {"id": "quirk_q1_hash_order_probability", "label": "Q1 hash-order comparative and superlative probability", "file_type": "concept", "source_file": "doc/source/overview/morphology_perl_quirks_ledger.rst", "source_location": "L17-L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Perl derives probability from hash-key iteration order; full-flow mode kept that order while differential oracle mode uses lexical order."}, {"id": "quirk_q2_ena_probability_carry", "label": "Q2 numeral -ena probability carry", "file_type": "concept", "source_file": "doc/source/overview/morphology_perl_quirks_ledger.rst", "source_location": "L45-L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Numeral -ena probabilities depend on mutable shared probability left by adjective generation, so Python carries that state only in full-flow mode."}, {"id": "quirk_q3_probability_empty_vs_zero", "label": "Q3 probability empty versus zero", "file_type": "concept", "source_file": "doc/source/overview/morphology_perl_quirks_ledger.rst", "source_location": "L75-L100", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Undefined probability prints as an empty field and literal 0 prints as 0, so the two must not be collapsed."}, {"id": "quirk_q4_r_stem_nouns", "label": "Q4 opt-in r-stem nouns", "file_type": "concept", "source_file": "doc/source/overview/morphology_perl_quirks_ledger.rst", "source_location": "L103-L117", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "doc_source_overview_morphology_perl_quirks_ledger", "target": "create_dict31_pl", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/source/overview/morphology_perl_quirks_ledger.rst", "source_location": "L4-L5", "weight": 1.0}, {"source": "doc_source_overview_morphology_perl_quirks_ledger", "target": "adr_0012", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/source/overview/morphology_perl_quirks_ledger.rst", "source_location": "L1