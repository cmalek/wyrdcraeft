{"nodes": [{"id": "fixture_wright_nouns", "label": "Wright nouns morphology fixture", "file_type": "document", "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixture excerpt of Old English noun accidence used to show how stem class, case, and prehistoric loss of endings determine the paradigms learners actually see."}, {"id": "oe_strong_declension", "label": "Vocalic or strong declension", "file_type": "concept", "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": "\u00a7 330", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nouns whose stems originally ended in a vowel. They fell together in the nominative and accusative singular after prehistoric loss of final short vowels and consonants, so classification has to start from Primitive Germanic, the plural, or comparison with other old Germanic languages."}, {"id": "oe_weak_declension", "label": "Weak n-stem declension", "file_type": "concept", "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": "\u00a7 330", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nouns whose stems originally ended in -n. Most original n-stem case endings disappeared, so the old stem element came to be regarded as a case ending."}, {"id": "oe_minor_declensions", "label": "Minor declensions", "file_type": "concept", "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": "\u00a7 330", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consonantal stems other than n-stems are grouped under this heading rather than with the vocalic strong declension or the weak declension."}, {"id": "oe_a_declension", "label": "a-declension", "file_type": "concept", "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": "\u00a7 333", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Masculine and neuter only, corresponding to the Latin and Greek o-declension, sometimes called the o-declension for that reason. Divided into pure a-stems, ja-stems, and wa-stems."}, {"id": "oe_noun_cases", "label": "Old English noun cases and genders", "file_type": "concept", "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": "\u00a7 332", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two numbers, three genders, and five cases: nominative, accusative, genitive, dative, and instrumental. The dative is generally used for the instrumental, the vocative matches the nominative, and nominative and accusative plural are always alike. The plural -as of a-stems is treated as historically difficult."}, {"id": "stan_paradigm", "label": "st\u0101n a-stem paradigm", "file_type": "concept", "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": "\u00a7 334", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Model for the majority of monosyllabic masculine a-stems: st\u0101n, st\u0101nes, st\u0101ne, st\u0101nas, st\u0101na, st\u0101num."}, {"id": "daeg_paradigm", "label": "d\u00e6g a-stem paradigm", "file_type": "concept", "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": "\u00a7 334", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows vowel alternation between singular d\u00e6g and plural dagas. Primitive Germanic forms such as nom. *\u0111aga\u0292 are given so the Old English endings can be derived from unaccented-vowel history."}, {"id": "fotiz_reconstruction", "label": "Primitive Germanic *f\u014dtiz", "file_type": "concept", "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": "\u00a7 331", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The fixture cites f\u0113t, feet, as Primitive Germanic nominative *f\u014dtiz, the same older plural used to explain why i-mutation is visible after the ending disappeared."}], "edges": [{"source": "fixture_wright_nouns", "target": "oe_strong_declension", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": "\u00a7 330", "weight": 1.0}, {"source": "fixture_wright_nouns", "target": "oe_weak_declension", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": "\u00a7 330", "weight": 1.0}, {"source": "fixture_wright_nouns", "target": "oe_minor_declensions", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": "\u00a7 330", "weight": 1.0}, {"source": "fixture_wright_nouns", "target": "oe_a_declension", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": "\u00a7 333", "weight": 1.0}, {"source": "fixture_wright_nouns", "target": "oe_noun_cases", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": "\u00a7 332", "weight": 1.0}, {"source": "fixture_wright_nouns", "target": "stan_paradigm", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": "\u00a7 334", "weight": 1.0}, {"source": "fixture_wright_nouns", "target": "daeg_paradigm", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/fixtures/morphology/wright_nouns.md", "source_location": "\u00a7 334", "weight": 1.0}, {"so