{"nodes": [{"id": "docs_adr_0011_verb_generators_leave_common_py", "label": "Verb generators leave common.py", "file_type": "document", "source_file": "docs/adr/0011-verb-generators-leave-common-py.md", "source_location": "L1-L88", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VerbFormGenerator, StrongVerbGenerator, and WeakVerbGenerator leave common.py into one file each and common.py is deleted with no compatibility re-export because that file remained a god module after ADR 0009, while adjectives and nouns already live as one class per file. The three classes are generation engines, not Wright conjugation classes."}, {"id": "verb_form_generator", "label": "VerbFormGenerator", "file_type": "concept", "source_file": "docs/adr/0011-verb-generators-leave-common-py.md", "source_location": "L6-L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VerbFormGenerator is the orchestrator callers already know: it special-cases paradigm type s onto Strong and sends w, pp, and a to Weak, and it constructs those collaborators itself."}, {"id": "generation_common_py", "label": "generation/common.py", "file_type": "code", "source_file": "docs/adr/0011-verb-generators-leave-common-py.md", "source_location": "L6-L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "common.py is deleted with no stub because leaving VerbFormGenerator there, or re-exporting it, would keep the god module and the redirect layer ADR 0009 removed."}, {"id": "verb_forms_py", "label": "verb_forms.py", "file_type": "code", "source_file": "docs/adr/0011-verb-generators-leave-common-py.md", "source_location": "L27-L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "verb_forms.py owns VerbFormGenerator and may import the strong and weak modules; those two must not import verb_forms.py."}, {"id": "strong_verb_forms_py", "label": "stro