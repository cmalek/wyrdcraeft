{"nodes": [{"id": "ref_0005_ocr_structuring_checklist", "label": "Reference 0005: OCR Structuring Checklist", "file_type": "document", "source_file": "teaching/machine-assistance/reference/0005-ocr-structuring-checklist.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turn a hard image-only Old English PDF into machine-usable data without losing the original evidence."}, {"id": "ocr_witness_not_truth", "label": "OCR output is a witness", "file_type": "concept", "source_file": "teaching/machine-assistance/reference/0005-ocr-structuring-checklist.html", "source_location": "One-line rule", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Treat OCR output as a witness, not final truth. Corrections belong in overlays or derived structure, not by erasing the raw evidence."}, {"id": "ocr_structuring_pipeline", "label": "OCR structuring pipeline", "file_type": "concept", "source_file": "teaching/machine-assistance/reference/0005-ocr-structuring-checklist.html", "source_location": "Pipeline", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stages are acquire, prepare, OCR, validate, anchor, adjudicate, and export. Each stage has a stop condition so a mistake can be located: incomplete source, preprocessing damage, lost page provenance, collapsed thorn/macrons/tables, untraceable text, silent in-place rewrite, or structure that cannot point back to witnesses."}, {"id": "raw_ocr_witness", "label": "Raw OCR witness", "file_type": "concept", "source_file": "teaching/machine-assistance/reference/0005-ocr-structuring-checklist.html", "source_location": "Artifact Ladder", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verbatim OCR output must preserve page identity, meaningful line breaks, and hard characters."}, {"id": "normalized_ocr_text", "label": "Normalized OCR text", "file_type": "concept", "source_file": "teaching/machine-assistance/reference/0005-ocr-structuring-checklist.html", "source_location": "Artifact Ladder", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exists for searchability and downstream cleanup, but must keep a link back to the raw witness."}, {"id": "correction_overlay", "label": "Correction overlay", "file_type": "concept", "source_file": "teaching/machine-assistance/reference/0005-ocr-structuring-checklist.html", "source_location": "Artifact Ladder", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Human corrections are recorded by exception, including what changed, why, and where. Corrections add layers; they do not replace witnesses."}, {"id": "structured_record", "label": "Structured OCR record", "file_type": "concept", "source_file": "teaching/machine-assistance/reference/0005-ocr-structuring-checklist.html", "source_location": "Artifact Ladder", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derived JSON, YAML, or JSONL for software and agents must still point back to witness spans or fragments."}, {"id": "ocr_hard_pdf_failure_modes", "label": "Hard-PDF OCR failure modes", "file_type": "concept", "source_file": "teaching/machine-assistance/reference/0005-ocr-structuring-checklist.html", "source_location": "Hard-PDF Failure Modes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "p for \u00fe or \u00f0, dropped macrons, normalized-away Greek or linguistic symbols, linearized tables, good prose with wrong structure, and cleaned text with no traceability each need a specific first response before broad correction."}, {"id": "ocr_d_workflow_guide", "label": "OCR-D Workflow Guide", "file_type": "paper", "source_file": "teaching/machine-assistance/reference/0005-ocr-structuring-checklist.html", "source_location": "Use These Files In This Repo", "source_url": "https://ocr-d.de/en/workflows", "captured_at": null, "author": null, "contributor": null, "rationale": "External workflow guide cited for how OCR pipelines should stay staged and understandable."}], "edges": [{"source": "ref_0005_ocr_structuring_checklist", "target": "machine_assistance_course", "relation": "part_of", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "teaching/machine-assistance/reference/0005-ocr-structuring-checklist.html", "source_location": null, "weight": 0.95}, {"source": "ref_0005_ocr_structuring_checklist", "target": "ocr_witness_not_truth", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/reference/0005-ocr-structuring-checklist.html", "source_location": "One-line rule", "weight": 1.0}, {"source": "ref_0005_ocr_structuring_checklist", "target": "ocr_structuring_pipeline", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/reference/0005-ocr-structuring-checklist.html", "source_location": "Pipeline", "weight": 1.0}, {"source": "ref_0005_ocr_structuring_checklist", "target": "raw_ocr_witness", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/reference/0005-ocr-structuring-checklist.html", "source_location": "Artifact Ladder", "weight": 1.0}, {"source": "ref_0005_ocr_structuring_checklist", "target": "normalized_ocr_text", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/reference/0005-ocr-structuring-checklist.html", "source_location": "Artifact Ladder", "weight": 1.0}, {"source": "ref_0005_ocr_structuring_checklist", "target": "correction_overlay", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/machine-assistance/reference/0005-ocr-structuring-checklist.html", "source_location": "A