{"nodes": [{"id": "ref_0003_sound_terms", "label": "Reference: Sound Terms for Historical Linguistics", "file_type": "document", "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sound changes target classes, places of articulation, and change-types; fast recognition of those labels matters more than perfect modern phonetics on day one."}, {"id": "lenition", "label": "Lenition", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Change Words", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A sound becomes weaker or less obstructed: a stop may become a fricative, a fricative weaker still, or a consonant may disappear. Loss of intervocalic h is taught as ordinary lenition in a weak environment."}, {"id": "fricative", "label": "Fricative", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Core Types", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A consonant made by forcing air through a narrow gap. Germanic sound laws constantly refer to f, \u00fe, h, and s as a class."}, {"id": "stop_consonant", "label": "Stop", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Core Types", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A consonant with full closure and release. Grimm's Law is described as stops shifting as classes."}, {"id": "glide", "label": "Glide", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Core Types", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A vowel-like consonant, especially j and w. In Proto-Germanic and Gothic, j is the y-sound [j], like English yes, not a front rounded vowel. It matters for i-mutation and palatal or labiovelar developments."}, {"id": "voiced", "label": "Voiced", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Voicing and Breath", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The vocal folds vibrate. Voicing is the conditioning that both Verner's Law and the Old English fricative rule depend on, in different ways."}, {"id": "voiceless", "label": "Voiceless", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Voicing and Breath", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The vocal folds do not vibrate. Grimm's Law begins from the PIE voiceless stops."}, {"id": "aspirated", "label": "Aspirated", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Voicing and Breath", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Released with a noticeable puff of breath. The traditional PIE voiced aspirates are a Grimm's Law class, approximated as breathy release rather than a stop plus a full separate h."}, {"id": "palatal", "label": "Palatal", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Place Words", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Made with the tongue toward the hard palate. Palatalized means a consonant that still has another primary place but takes a secondary y-like coloring, which is how dotted \u010b and \u0121 are explained."}, {"id": "dissimilation", "label": "Dissimilation", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Change Words", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One sound becomes less like a nearby sound."}, {"id": "apocope", "label": "Apocope", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Change Words", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loss of a final sound or syllable. Distinct from syncope, which is loss of an unstressed vowel inside a word."}, {"id": "fortition", "label": "Fortition", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Change Words", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A sound becomes stronger or more obstructed, the counterpart of lenition."}], "edges": [{"source": "ref_0003_sound_terms", "target": "oe_historical_grammar_course", "relation": "part_of", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": null, "weight": 0.95}, {"source": "ref_0003_sound_terms", "target": "fricative", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Core Types", "weight": 1.0}, {"source": "ref_0003_sound_terms", "target": "stop_consonant", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Core Types", "weight": 1.0}, {"source": "ref_0003_sound_terms", "target": "glide", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Core Types", "weight": 1.0}, {"source": "ref_0003_sound_terms", "target": "voiced", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Voicing and Breath", "weight": 1.0}, {"source": "ref_0003_sound_terms", "target": "voiceless", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Voicing and Breath", "weight": 1.0}, {"source": "ref_0003_sound_terms", "target": "aspirated", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Voicing and Breath", "weight": 1.0}, {"source": "ref_0003_sound_terms", "target": "palatal", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Place Words", "weight": 1.0}, {"source": "ref_0003_sound_terms", "target": "lenition", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Change Words", "weight": 1.0}, {"source": "ref_0003_sound_terms", "target": "dissimilation", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Change Words", "weight": 1.0}, {"source": "ref_0003_sound_terms", "target": "apocope", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Change Words", "weight": 1.0}, {"source": "ref_0003_sound_terms", "target": "fortition", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Change Words", "weight": 1.0}, {"source": "ref_0003_sound_terms", "target": "syncope", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Change Words", "weight": 1.0}, {"source": "ref_0003_sound_terms", "target": "assimilation", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Change Words", "weight": 1.0}, {"source": "ref_0003_sound_terms", "target": "palatalization", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Change Words", "weight": 1.0}, {"source": "ref_0003_sound_terms", "target": "ablaut", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Change Words", "weight": 1.0}, {"source": "ref_0003_sound_terms", "target": "umlaut", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Change Words", "weight": 1.0}, {"source": "grimms_law", "target": "stop_consonant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Core Types", "weight": 1.0}, {"source": "i_mutation", "target": "glide", "relation": "depends_on", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Core Types", "weight": 1.0}, {"source": "palatalization", "target": "palatal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0003-sound-terms.html", "source_location": "Change Words", "weight": 1.0}, {"source": "ref_0003_sound_terms", "targe