{"nodes": [{"id": "lesson_0003_pronouncing_oe", "label": "Lesson 0003: Pronouncing Old English Letters", "file_type": "document", "source_file": "teaching/oe-grammar/lessons/0003-pronouncing-old-english-letters.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A safe usable pronunciation system for reading, not a claim that one perfectly exact Old English accent can be recovered."}, {"id": "oe_fricative_voicing", "label": "Old English fricative voicing", "file_type": "concept", "source_file": "teaching/oe-grammar/lessons/0003-pronouncing-old-english-letters.html", "source_location": "3. Voicing Rules for Fricatives", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "f, s, and \u00fe/\u00f0 are voiceless initially, finally, and in voiceless environments, and voiced between voiced sounds. Scribes did not consistently reserve \u00fe for [\u03b8] and \u00f0 for [\u00f0]; the environment tells more than the symbol."}, {"id": "oe_c_pronunciation", "label": "Old English c pronunciation", "file_type": "concept", "source_file": "teaching/oe-grammar/lessons/0003-pronouncing-old-english-letters.html", "source_location": "4a. c", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "[k] before another consonant or in back-vowel environments. In palatal environments the learner-safe value is [t\u0283], because older grammars disagree on the narrow value and Wright is more conservative."}, {"id": "oe_g_pronunciation", "label": "Old English g pronunciation", "file_type": "concept", "source_file": "teaching/oe-grammar/lessons/0003-pronouncing-old-english-letters.html", "source_location": "4b. g", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beginner values are [g] initially before back vowels, before consonants, after [\u014b], and when doubled; [\u0263] medially between back vowels and often finally after back vowels; [j] in palatal environments. Initial non-palatal g is not taught as [\u0262]."}, {"id": "oe_h_pronunciation", "label": "Old English h pronunciation", "file_type": "concept", "source_file": "teaching/oe-grammar/lessons/0003-pronouncing-old-english-letters.html", "source_location": "4c. h", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "[h] initially; [\u00e7] after front vowels when non-initial; [x] after back vowels or consonants when non-initial. The guttural quality away from initial position splits into those two non-initial values."}, {"id": "oe_sc_cg", "label": "Old English sc and cg", "file_type": "concept", "source_file": "teaching/oe-grammar/lessons/0003-pronouncing-old-english-letters.html", "source_location": "4d. Letter Combinations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Treat sc as [\u0283] (scip, sceal) and cg as [d\u0292] (ecg, brycg), as units rather than two separate letters."}, {"id": "oe_vowel_length", "label": "Old English vowel length from macrons", "file_type": "concept", "source_file": "teaching/oe-grammar/lessons/0003-pronouncing-old-english-letters.html", "source_location": "5. A Mini Reading Routine", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The reading routine starts by identifying long vowels from macrons in teaching editions. Classroom comparison words and a single IPA symbol are layered approximations, which is why descriptions can seem to disagree."}, {"id": "mitchell_robinson_guide", "label": "Mitchell and Robinson, A Guide to Old English", "file_type": "paper", "source_file": "teaching/oe-grammar/lessons/0003-pronouncing-old-english-letters.html", "source_location": "Sources Used", "source_url": "/Users/cmalek/src/workspace/wyrdcraeft/data/sources/mitchell.md", "captured_at": null, "author": "Bruce Mitchell and Fred C. Robinson", "contributor": null, "rationale": "Used only as a secondary check. The local extract has OCR noise, including macron and umlaut confusion, so it was not relied on for exact diacritics."}], "edges": [{"source": "lesson_0003_pronouncing_oe", "target": "oe_historical_grammar_course", "relation": "part_of", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "teaching/oe-grammar/lessons/0003-pronouncing-old-english-letters.html", "source_location": null, "weight": 0.95}, {"source": "lesson_0003_pronouncing_oe", "target": "oe_fricative_voicing", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0003-pronouncing-old-english-letters.html", "source_location": "3. Voicing Rules for Fricatives", "weight": 1.0}, {"source": "lesson_0003_pronouncing_oe", "target": "oe_c_pronunciation", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0003-pronouncing-old-english-letters.html", "source_location": "4a. c", "weight": 1.0}, {"source": "lesson_0003_pronouncing_oe", "target": "oe_g_pronunciation", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0003-pronouncing-old-english-letters.html", "source_location": "4b. g", "weight": 1.0}, {"source": "lesson_0003_pronouncing_oe", "target": "oe_h_pronunciation", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0003-pronouncing-old-english-letters.html", "source_location": "4c. h", "weight": 1.0}, {"source": "lesson_0003_pronouncing_oe", "target": "oe_sc_cg", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0003-pronouncing-old-english-letters.html", "source_location": "4d. Letter Combinations", "weight": 1.0}, {"source": "lesson_0003_pronouncing_oe", "target": "oe_vowel_length", "relation": "defines", "conf