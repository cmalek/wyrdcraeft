{"nodes": [{"id": "doc_bt_index_orchestration", "label": "Bosworth-Toller Dictionary Index Orchestration Guide", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-21-bosworth-toller-dictionary-index/ORCHESTRATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An orchestrator dispatches one phase subagent at a time and treats the filesystem, not chat history, as the system of record."}, {"id": "bt_index_phase_chain", "label": "BT dictionary index phase chain", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-21-bosworth-toller-dictionary-index/ORCHESTRATION.md", "source_location": "Phase order", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phases 01 through 08 are required, from models and the line parser through editorial merge, SQLite, lookup, and morphology join; phase 09 LLM fix is optional."}, {"id": "orchestrator_cost_policy", "label": "Orchestrator model cost policy", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-21-bosworth-toller-dictionary-index/ORCHESTRATION.md", "source_location": "Model selection", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pick the cheapest model that can pass phase gates; lint failures retry the same model and golden failures upgrade one tier."}, {"id": "orchestration_homograph_key", "label": "Orchestration homograph key (norm_key, pos)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-21-bosworth-toller-dictionary-index/ORCHESTRATION.md", "source_location": "Checkpoint template", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The June orchestration locks homographs as splitting by POS and merging within POS, and expects a separate dictionary.sqlite3 beside morphology.sqlite3."}], "edges": [{"source": "doc_bt_index_orchestration", "t