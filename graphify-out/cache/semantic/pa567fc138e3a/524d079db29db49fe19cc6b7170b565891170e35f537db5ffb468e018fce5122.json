{"nodes": [{"id": "oe_grammar_resources", "label": "Historical Linguistics for Old English Study Resources", "file_type": "document", "source_file": "teaching/oe-grammar/RESOURCES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resource list for building Old English historical-grammar intuition, with explicit gaps for a beginner sequence on i-mutation, a-mutation, and breaking, and for syncope, assimilation, and analogy."}, {"id": "wright_old_english_grammar", "label": "Wright and Wright, Old English Grammar", "file_type": "paper", "source_file": "teaching/oe-grammar/RESOURCES.md", "source_location": "Knowledge", "source_url": "https://archive.org/search?query=title%3A%28Old+English+Grammar%29+creator%3A%28Wright%29", "captured_at": null, "author": "Joseph Wright and Elizabeth Mary Wright", "contributor": null, "rationale": "Classic reference grammar in the older philological style. Used for traditional accounts of sound changes, inflection, dialect notes, vowel contraction, and historical terminology. Local workspace extract is data/sources/wright.md."}, {"id": "bosworth_toller", "label": "Bosworth-Toller Anglo-Saxon Dictionary", "file_type": "paper", "source_file": "teaching/oe-grammar/RESOURCES.md", "source_location": "Knowledge", "source_url": "https://lrc.la.utexas.edu/lex/master", "captured_at": null, "author": null, "contributor": null, "rationale": "Major Old English dictionary, used for attested forms, semantic range, older lexical evidence, and as the page image behind entry structuring."}, {"id": "lehmann_grammar_of_proto_germanic", "label": "Lehmann, A Grammar of Proto-Germanic", "file_type": "paper", "source_file": "teaching/oe-grammar/RESOURCES.md", "source_location": "Knowledge", "source_url": "https://lrc.la.utexas.edu/books/pgmc", "captured_at": null, "author": "Winfred P. Lehmann", "contributor": null, "rationale": "Core reference for Proto-Germanic, the comparative method, and the major Germanic sound shifts, especially the map from PIE to Proto-Germanic."}, {"id": "old_english_online", "label": "Old English Online", "file_type": "paper", "source_file": "teaching/oe-grammar/RESOURCES.md", "source_location": "Knowledge", "source_url": "https://lrc.la.utexas.edu/eieol/engol", "captured_at": null, "author": "Jonathan Slocum and Winfred P. Lehmann", "contributor": null, "rationale": "Practical Old English grammar and reading lessons. The phonology overview is cited for how c and g split between guttural and palatal values, and for the alphabet and sound system."}, {"id": "ie_lexicon", "label": "Indo-European Lexicon", "file_type": "paper", "source_file": "teaching/oe-grammar/RESOURCES.md", "source_location": "Knowledge", "source_url": "https://lrc.la.utexas.edu/lex", "captured_at": null, "author": null, "contributor": "University of Texas LRC", "rationale": "Database of reconstructed PIE roots and daughter-language reflexes, used to get comfortable with reconstruction notation."}, {"id": "ie_lexicon_user_guide", "label": "Indo-European Lexicon User Guide", "file_type": "paper", "source_file": "teaching/oe-grammar/RESOURCES.md", "source_location": "Knowledge", "source_url": "https://lrc.la.utexas.edu/guides/lex_user", "captured_at": null, "author": null, "contributor": "University of Texas LRC", "rationale": "Beginner-friendly explanation of reconstructed roots, reflexes, and daughter languages."}, {"id": "campbell_historical_linguistics", "label": "Campbell, Historical Linguistics", "file_type": "paper", "source_file": "teaching/oe-grammar/RESOURCES.md", "source_location": "Knowledge", "source_url": "https://ocw.mit.edu/courses/24-914-language-variation-and-change-spring-2019/pages/readings/", "captured_at": null, "author": "Lyle Campbell", "contributor": null, "rationale": "Held as the standard modern introductory textbook to expand into after the first lessons. The LSA review is cited as confirmation of that status."}, {"id": "lsa_review_campbell", "label": "LSA review of Campbell's Historical Linguistics", "file_type": "paper", "source_file": "teaching/oe-grammar/RESOURCES.md", "source_location": "Knowledge", "source_url": "https://journals.linguisticsociety.org/booknotices/?p=91", "captured_at": null, "author": null, "contributor": "Linguistic Society of America", "rationale": "Useful confirmation that Campbell is a standard introductory textbook, for choosing a deeper book when ready."}, {"id": "r_linguistics", "label": "r/linguistics", "file_type": "document", "source_file": "teaching/oe-grammar/RESOURCES.md", "source_location": "Wisdom (Communities)", "source_url": "https://www.reddit.com/r/linguistics/", "captured_at": null, "author": null, "contributor": null, "rationale": "Useful for book recommendations and terminology questions, but quality varies, so it is not a source of settled fact."}, {"id": "linguist_list", "label": "Linguist List", "file_type": "document", "source_file": "teaching/oe-grammar/RESOURCES.md", "source_location": "Wisdom (Communities)", "source_url": "https://linguistlist.org/", "captured_at": null, "author": null, "contributor": null, "rationale": "Professional field hub for conferences, reading lists, and institutional resources."}, {"id": "resource_gaps", "label": "Open-access resource gaps", "file_type": "rationale", "source_file": "teaching/oe-grammar/RESOURCES.md", "source_location": "Gaps", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing a single beginner open-access sequence on Old English i-mutation, a-mutation, and breaking; a community specifically for Germanic historical-linguistics learners; and focused open-access treatments of syncope, assimilation, and analogy in Old English and Old Norse."}, {"id": "university_of_texas_lrc", "label": "University of Texas Linguistics Research Center", "file_type": "concept", "source_file": "teaching/oe-grammar/RESOURCES.md", "source_location": "Knowledge", "source_url":