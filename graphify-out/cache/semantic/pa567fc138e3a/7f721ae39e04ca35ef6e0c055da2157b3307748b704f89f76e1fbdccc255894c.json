{"nodes": [{"id": "ref_0001_sound_change_map", "label": "Reference: Germanic Sound-Change Map", "file_type": "document", "source_file": "teaching/oe-grammar/reference/0001-sound-change-map.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quick-reference order for the changes that show up most often in beginner Old English historical grammar, so terminology stays stable across sessions."}, {"id": "a_mutation", "label": "a-mutation", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0001-sound-change-map.html", "source_location": "What Each Name Usually Means", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vowel change caused by a following a in some Germanic languages; explains why expected front vowels may retreat or lower."}, {"id": "o_mutation", "label": "o-mutation", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0001-sound-change-map.html", "source_location": "What Each Name Usually Means", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vowel change caused by a following o or u. Important in Old Norse and some other branches."}, {"id": "breaking", "label": "Breaking", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0001-sound-change-map.html", "source_location": "What Each Name Usually Means", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A vowel becomes a diphthong or more complex vowel near certain consonants. Very common in Old English form and spelling histories, and later than the shared Germanic consonant shifts."}, {"id": "syncope", "label": "Syncope", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0001-sound-change-map.html", "source_location": "What Each Name Usually Means", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loss of an unstressed vowel, often in medial syllables. Included so the course does not treat only the headline sound laws as the machinery that shapes Old English forms."}, {"id": "assimilation", "label": "Assimilation", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0001-sound-change-map.html", "source_location": "What Each Name Usually Means", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One sound becomes more like a nearby sound. Regular local changes that are less famous than Grimm's Law but often matter more for reading forms."}, {"id": "gemination", "label": "Gemination", "file_type": "concept", "source_file": "teaching/oe-grammar/reference/0001-sound-change-map.html", "source_location": "What Each Name Usually Means", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A consonant is lengthened, often after a triggering segment such as j. Important in Old English phonological history and spelling."}], "edges": [{"source": "ref_0001_sound_change_map", "target": "oe_historical_grammar_course", "relation": "part_of", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "teaching/oe-grammar/reference/0001-sound-change-map.html", "source_location": null, "weight": 0.95}, {"source": "ref_0001_sound_change_map", "target": "grimms_law", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0001-sound-change-map.html", "source_location": "What Each Name Usually Means", "weight": 1.0}, {"source": "ref_0001_sound_change_map", "target": "verners_law", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/reference/0001-sound-change-map.html", "source_location": "What Each Name Usually Means", "weight": 1.0}, {"source": "ref_0001_sound_change_map", "target": "i_mutation", "relation": "defines", "confidence": "EXTRACTED",