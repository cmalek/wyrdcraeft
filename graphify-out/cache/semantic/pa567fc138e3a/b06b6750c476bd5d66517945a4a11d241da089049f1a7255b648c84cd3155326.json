{"nodes": [{"id": "docs_adr_0002_canonical_morphology_db_uses_startup_alembic_migrations", "label": "Canonical morphology DB uses startup Alembic migrations", "file_type": "document", "source_file": "docs/adr/0002-canonical-morphology-db-uses-startup-alembic-migrations.md", "source_location": "L1-L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every database-using command migrates one app-data wyrdcraeft.sqlite3 to Alembic head before use so lexicon browse can depend on morphology, dictionary, and lexicon together, schema changes do not force surprise hand rebuilds, and a legacy database gets one pre-migration backup, restore-on-failure, and a single rebuild recipe."}, {"id": "wyrdcraeft_sqlite3", "label": "wyrdcraeft.sqlite3", "file_type": "concept", "source_file": "docs/adr/0002-canonical-morphology-db-uses-startup-alembic-migrations.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One app-data SQLite file is the canonical working database for morphology, attached dictionary data, and derived lexicon data so browse does not drift from curated rows."}, {"id": "alembic_startup_migration", "label": "Startup Alembic migration", "file_type": "concept", "source_file": "docs/adr/0002-canonical-morphology-db-uses-startup-alembic-migrations.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One startup path can take a pre-migration backup, restore on failure, stop, and print one rebuild recipe when a legacy pre-Alembic database must be reset."}, {"id": "build_command_family", "label": "build subcommand family", "file_type": "concept", "source_file": "docs/adr/0002-canonical-morphology-db-uses-startup-alembic-migrations.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Long-running database producers share the sub