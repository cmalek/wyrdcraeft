{"nodes": [{"id": "doc_lexicon_build_monitor", "label": "Lexicon Build Monitor Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-06-28-lexicon-build-monitor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Make lexicon build launch a Textual monitor by default so stage progress, structured logs, and cooperative cancel stay visible without holding giant forms and search-key lists in Python."}, {"id": "lexicon_build_controller", "label": "LexiconBuildController", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-28-lexicon-build-monitor.md", "source_location": "Task 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One shared threading.Thread runtime serves both the Textual monitor and the plain --no-tui renderer, delivering events through queue.SimpleQueue."}, {"id": "lexicon_build_monitor_app", "label": "LexiconBuildMonitorApp", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-28-lexicon-build-monitor.md", "source_location": "Task 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-screen Textual monitor is the default interactive path; q requests cancel during a run and exits the final screen."}, {"id": "rebuild_lexicon", "label": "rebuild_lexicon", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-28-lexicon-build-monitor.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single build entrypoint that emits typed events and honors cooperative cancellation via LexiconBuildCancelledError."}, {"id": "lexicon_build_stage", "label": "LexiconBuildStage", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-28-lexicon-build-monitor.md", "source_location": "Task 1", "source_url": null, "captured_at": null, "