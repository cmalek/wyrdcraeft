{"nodes": [{"id": "doc_source_overview_command_convert_mark_diacritics", "label": "source mark-diacritics", "file_type": "document", "source_file": "doc/source/overview/command_convert_mark_diacritics.rst", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_source_overview_command_convert_mark_diacritics_additive_marking", "label": "Additive Mark Transfer", "file_type": "rationale", "source_file": "doc/source/overview/command_convert_mark_diacritics.rst", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The command only adds combining marks. It never removes or replaces a character, never converts eth and thorn, and never changes hyphens or case. Marks already in the source are kept."}, {"id": "doc_source_overview_command_convert_mark_diacritics_ambiguity_policy", "label": "mark-diacritics Ambiguity Policy", "file_type": "rationale", "source_file": "doc/source/overview/command_convert_mark_diacritics.rst", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "auto applies the union of marks when some option is hyphenated or the key has 8 or more letters, except when marks differ before the first hyphen. leave changes nothing. union applies the mark union wherever letters align. Completed keys are never guessed."}, {"id": "doc_source_overview_command_convert_mark_diacritics_standard_elements", "label": "standard_elements.txt", "file_type": "concept", "source_file": "doc/source/overview/command_convert_mark_diacritics.rst", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bosworth-Toller mark variants of prefixes and compound elements are editorial or scribal, not meaning differences, so a hand-edited list forces one spelling only where the index form has a hyphen."}, {"id": "doc_source_overview_command_convert_mark_diacritics_diphthong_unit", "label": "Diphthong As One Unit", "file_type": "rationale", "source_file": "doc/source/overview/command_convert_mark_diacritics.rst", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ea, eo, ie, and io not split by a hyphen are one unit whose macron goes on the first vowel. If the source already marks either vowel, nothing is added."}], "edges": [{"source": "doc_source_overview_command_convert_mark_diacritics_additive_marking", "target": "context_diacritic_marking", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "doc/source/overview/command_convert_mark_diacritics.rst", "source_location": null, "weight": 1.0}, {"source": "doc_source_overview_command_convert_mark_diacritics_ambiguity_policy", "target": "context_ambiguity_policy", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "doc/source/overview/command_convert_mark_diacritics.rst", "source_location": null, "weight": 1.0}, {"source": "doc_source_overview_command_convert_mark_diacritics_standard_elements", "target": "context_standard_element", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "doc/source/overview/command_convert_mark_diacritics.rst", "source_location": null, "weight": 1.0}, {"source": "doc_source_overview_command_convert_mark_diacritics_diphthong_unit", "target": "doc_source_overview_command_convert_mark_diacritics_additive_marking", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/source/overview/command_convert_mark_diacritics.rst", "source_location": null, "weight": 1.0}, {"source": "doc_source_overview_command_convert_mark_diacritics_standard_elements", "target": "doc_source_overview_command_convert_mark_diacritics_additive_marking", "relation": "references", "confidence": "E