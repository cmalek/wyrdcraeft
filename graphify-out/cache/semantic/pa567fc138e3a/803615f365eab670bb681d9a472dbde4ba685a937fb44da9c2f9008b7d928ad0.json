{"nodes": [{"id": "docs_adr_0005_bt_source_acquisition_uses_multi_witness_download_set", "label": "BT source acquisition uses a multi-witness download set", "file_type": "document", "source_file": "docs/adr/0005-bt-source-acquisition-uses-multi-witness-download-set.md", "source_location": "L1-L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A small fixed witness set replaces treating oe_bt.txt as the only input because no single Bosworth-Toller source is trustworthy: local text is noisy, generic OCR drops structure, PDFs are worse OCR inputs than raw page images, and Internet Archive djvu.txt is too degraded for spelling or structure. Superseded: the OCR pipeline moved to wordwending."}, {"id": "multi_witness_download_set", "label": "Multi-witness Bosworth-Toller download set", "file_type": "concept", "source_file": "docs/adr/0005-bt-source-acquisition-uses-multi-witness-download-set.md", "source_location": "L5-L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Witness diversity supports lossless entries, preserved attestations, and review ranked by disagreement rather than by parser confidence alone."}, {"id": "glp_corrected_text", "label": "GLP corrected Bosworth-Toller text", "file_type": "concept", "source_file": "docs/adr/0005-bt-source-acquisition-uses-multi-witness-download-set.md", "source_location": "L5", "source_url": "https://www.germanic-lexicon-project.org/txt/oe_bosworthtoller.txt", "captured_at": null, "author": null, "contributor": null}, {"id": "glp_abbreviations_xml", "label": "GLP abbreviations XML", "file_type": "concept", "source_file": "docs/adr/0005-bt-source-acquisition-uses-multi-witness-download-set.md", "source_location": "L5", "source_url": "https://www.germanic-lexicon-project.org/xml/oe_bosworthtoller/oebt_abbreviations.xml", "captured_at": null, "author": null, "contributor": null}, {"id": "ia_jp2_scans", "label": "Internet Archive JP2 scan witnesses", "file_type": "concept", "source_file": "docs/adr/0005-bt-source-acquisition-uses-multi-witness-download-set.md", "source_location": "L5", "source_url": "https://archive.org/download/anglosaxondictio00bosw/anglosaxondictio00bosw_orig_jp2.tar", "captured_at": null, "author": null, "contributor": null, "rationale": "Main-volume and supplement JP2 images are the primary scan witnesses for OCR because raw page images beat PDFs as OCR input."}, {"id": "ia_djvu_txt", "label": "Internet Archive djvu.txt fallback", "file_type": "concept", "source_file": "docs/adr/0005-bt-source-acquisition-uses-multi-witness-download-set.md", "source_location": "L5-L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "djvu.txt is fallback-only rough recall because it is too degraded for trusted spelling or structure."}], "edges": [{"source": "docs_adr_0005_bt_source_acquisition_uses_multi_witness_download_set", "target": "multi_witness_download_set", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0005-bt-source-acquisition-uses-multi-witness-download-set.md", "source_location": "L5", "weight": 1.0}, {"source": "multi_witness_download_set", "target": "glp_corrected_text", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0005-bt-source-acquisition-uses-multi-witness-download-set.md", "source_location": "L5", "weight": 1.0}, {"source": "multi_witness_download_set", "target": "glp_abbreviations_xml", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0005-bt-source-acquisition-uses-multi-witness-download-set.md", "source_location": "L5", "weight": 1.0}, {"source": "multi_witness_download_set", "target": "ia_jp2_scans", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0005-bt-source-acquisition-uses-multi-witness-download-set.md", "source_l