{"nodes": [{"id": "lesson_0002_oe_dialects", "label": "Lesson 0002: Recognizing Old English Dialects in Writing", "file_type": "document", "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When a written Old English form looks off, ask whether it is a dialect clue rather than a mistake."}, {"id": "west_saxon", "label": "West Saxon", "file_type": "concept", "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "1. Where the Dialects Sit", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "South of the Thames except Kent and Surrey. Usual grammar baseline because so much surviving prose is copied in West Saxon. Learners often mistake it for Old English as a whole. Early West Saxon is the standard in Wright's grammar."}, {"id": "anglian", "label": "Anglian", "file_type": "concept", "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "1. Where the Dialects Sit", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mercian and Northumbrian grouped together. Often easier to identify as Anglian-like before separating the two. A high-value cue is West Saxon ea appearing as \u00e6 or e."}, {"id": "mercian", "label": "Mercian", "file_type": "concept", "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "1. Where the Dialects Sit", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Between the Humber and the Thames. Special umlaut spellings such as featu, heafuc, and fearan beside fatu, hafoc, and faran help isolate it."}, {"id": "northumbrian", "label": "Northumbrian", "file_type": "concept", "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "1. Where the Dialects Sit", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Between the Firth of Forth and the Humber. Recognized from spellings such as eorm, heord, \u00e6hher, and t\u00e6hher rather than one giant rule. Wright notes noun declension and gender fluctuated more here than in other dialects."}, {"id": "kentish", "label": "Kentish", "file_type": "concept", "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "1. Where the Dialects Sit", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kent and Surrey. Often shows e where West Saxon has \u00e6 or ea (d\u00e6g/deg, f\u00e6der/feder), and sometimes keeps wio- where West Saxon and Anglian have wu- (wudu/wiodu)."}, {"id": "mixed_dialect_copying", "label": "Mixed dialect spellings in copies", "file_type": "concept", "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "4a. Why One Text May Show Mixed Dialect Spellings", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copyists introduce their own dialect or leave older forms behind when transcribing across dialects. Much Old English poetry was originally Anglian but survives in later West Saxon copies. Mixed spellings are evidence of scribal habit, exemplar history, and dialect mixing, not automatic proof of multiple hands."}], "edges": [{"source": "lesson_0002_oe_dialects", "target": "oe_historical_grammar_course", "relation": "part_of", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": null, "weight": 0.95}, {"source": "lesson_0002_oe_dialects", "target": "west_saxon", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "1. Where the Dialects Sit", "weight": 1.0}, {"source": "lesson_0002_oe_dialects", "target": "anglian", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "1. Where the Dialects Sit", "weight": 1.0}, {"source": "lesson_0002_oe_dialects", "target": "mercian", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "1. Where the Dialects Sit", "weight": 1.0}, {"source": "lesson_0002_oe_dialects", "target": "northumbrian", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "1. Where the Dialects Sit", "weight": 1.0}, {"source": "lesson_0002_oe_dialects", "target": "kentish", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "1. Where the Dialects Sit", "weight": 1.0}, {"source": "lesson_0002_oe_dialects", "target": "mixed_dialect_copying", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "4a. Why One Text May Show Mixed Dialect Spellings", "weight": 1.0}, {"source": "mercian", "target": "anglian", "relation": "part_of", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "1. Where the Dialects Sit", "weight": 1.0}, {"source": "northumbrian", "target": "anglian", "relation": "part_of", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "1. Where the Dialects Sit", "weight": 1.0}, {"source": "lesson_0002_oe_dialects", "target": "lesson_0001_sound_change", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "6. Keep Nearby", "weight": 1.0}, {"source": "lesson_0002_oe_dialects", "target": "ref_0004_oe_dialect_cues", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "6. Keep Nearby", "weight": 1.0}, {"source": "lesson_0002_oe_dialects", "target": "ref_0003_sound_terms", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "6. Keep Nearby", "weight": 1.0}, {"source": "lesson_0002_oe_dialects", "target": "wright_old_english_grammar", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "Sources Used", "weight": 1.0}, {"source": "lesson_0002_oe_dialects", "target": "bosworth_toller", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "Sources Used", "weight": 1.0}, {"source": "daeg_paradigm", "target": "kentish", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "teaching/oe-grammar/lessons/0002-recognizing-oe-dialects-in-writing.html", "source_location": "Cue B", "weight": 0.75}], "hyperedges": []}