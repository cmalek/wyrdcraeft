{"nodes": [{"id": "docs_adr_0007_ocr_pipeline_moves_to_bochord", "label": "OCR pipeline moves to bochord", "file_type": "document", "source_file": "docs/adr/0007-ocr-pipeline-moves-to-bochord.md", "source_location": "L1-L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OCR leaves wyrdcraeft because it is upstream data acquisition, not core grammar, dictionary, morphology, or diacritic logic, and image-heavy artifacts plus olmocr, ocrmypdf, and appleocr do not belong in this library. The sibling was renamed from bochord to wordwending because GitHub already had a bochord repository; this filename stays so existing links keep working."}, {"id": "wordwending", "label": "wordwending", "file_type": "concept", "source_file": "docs/adr/0007-ocr-pipeline-moves-to-bochord.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The sibling repository, formerly bochord, owns image acquisition, tiling, witness OCR, and the OCR proxy so wyrdcraeft only consumes dropped-in artifacts."}, {"id": "bochord", "label": "bochord", "file_type": "concept", "source_file": "docs/adr/0007-ocr-pipeline-moves-to-bochord.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "bochord was the planned sibling name, but GitHub already had that repository, so the project was renamed wordwending while this ADR filename stayed."}, {"id": "olmocr", "label": "olmocr", "file_type": "concept", "source_file": "docs/adr/0007-ocr-pipeline-moves-to-bochord.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "olmocr, ocrmypdf, and appleocr are heavyweight OCR dependencies removed from wyrdcraeft with the pipeline."}, {"id": "oe_bosworthtoller_text_kept", "label": "Kept plain-text Bosworth-Toller sources", "file_type": "concept", "source_file": "docs/adr/0007-ocr-pi