{"nodes": [{"id": "bt_visibility_review", "label": "BT Structural Visibility Review", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-28-bt-visibility-review.md", "source_location": "L1-L143", "source_url": null, "captured_at": "2026-06-28", "author": null, "contributor": null, "rationale": "Before changing the BT parser and storage model, a reviewed sample must separate structural-only headings that should be hidden by default from genuine lexical content that must remain visible. The review decides translator-facing default visibility only; scholarly structure stays in storage."}, {"id": "hide_by_default", "label": "hide_by_default", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-28-bt-visibility-review.md", "source_location": "L94-L107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hide text by default when it is only structural framing and does not stand alone as a useful dictionary gloss."}, {"id": "keep_visible", "label": "keep_visible", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-28-bt-visibility-review.md", "source_location": "L99-L112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep text visible when it still carries lexical meaning a translator would want, even if the wording is framed structurally."}, {"id": "bt_v2_default_visibility", "label": "BT v2 default visibility policy", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-28-bt-visibility-review.md", "source_location": "L29-L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The review artifact's job is to define default visibility for structural nodes in the future BT v2 tree, not to implement the parser or schema migration."}, {"id": "structural_usage_headings", "label": "Structural grammar and usage headings", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-28-bt-visibility-review.md", "source_location": "L54-L69", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sample must cover with/without/of/in/when/introducing headings, hierarchical family buckets, and counterexamples that still carry lexical content."}, {"id": "sense_segmenter", "label": "sense_segmenter.py", "file_type": "code", "source_file": "docs/superpowers/specs/2026-06-28-bt-visibility-review.md", "source_location": "L21-L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An earlier narrow plan treated the problem as only a post-strip filter in sense_segmenter.py; current examples show a broader problem space."}, {"id": "dictionary_lookup_command", "label": "wyrdcraeft dictionary lookup", "file_type": "code", "source_file": "docs/superpowers/specs/2026-06-28-bt-visibility-review.md", "source_location": "L137-L143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Downstream BT v2 migration uses the review to decide which tree nodes are visible by default in dictionary lookup and lexicon detail views."}, {"id": "oe_bt_txt", "label": "data/oe_bt.txt", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-28-bt-visibility-review.md", "source_location": "L128", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Review artifact must be inspectable without loading the Bosworth-Toller source corpus into context."}], "edges": [{"source": "bt_visibility_review", "target": "hide_by_default", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-28-bt-visibility-review.md", "source_location": "L41-L107", "weight": 1.0}, {"source": "bt_visibility_review", "target": "keep_visible", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2