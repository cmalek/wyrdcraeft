{"nodes": [{"id": "docs_adr_0002_normalized_canonical_schema", "label": "Normalized canonical schema with unified parts of speech", "file_type": "document", "source_file": "docs/adr/0002-normalized-canonical-schema.md", "source_location": "L1-L61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Product tables are normalized around parts_of_speech and inflection_codes because the schema had grown from legacy morphology TSV columns and a lexicon read model that duplicated dictionary and morphology rows."}, {"id": "parts_of_speech", "label": "parts_of_speech", "file_type": "concept", "source_file": "docs/adr/0002-normalized-canonical-schema.md", "source_location": "L23-L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "parts_of_speech is the single POS source of truth so product tables store pos_id or wordclass_id instead of three parallel free-text vocabularies."}, {"id": "inflection_codes", "label": "inflection_codes", "file_type": "concept", "source_file": "docs/adr/0002-normalized-canonical-schema.md", "source_location": "L26-L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compact function codes are a lookup scoped by pos_id so forms stores inflection_code_id rather than a free-text function or a column named pos."}, {"id": "search_keys", "label": "search_keys", "file_type": "concept", "source_file": "docs/adr/0002-normalized-canonical-schema.md", "source_location": "L34-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lexicon_entries and lexicon_forms are dropped and lexicon_search_keys is renamed search_keys because browse and query read source tables directly and only ranked search keys remain derived."}, {"id": "forms_entry_id", "label": "forms.entry_id", "file_type": "concept", "source_file": "docs/adr/0002-normalized-canonical-schema.md", "source_location": "L29-L30", "so