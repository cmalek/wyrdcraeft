{"nodes": [{"id": "docs_adr_0008_architecture_review_2026_08_01", "label": "Architecture review 2026-08-01", "file_type": "document", "source_file": "docs/adr/0008-architecture-review-2026-08-01.md", "source_location": "L1-L134", "source_url": null, "captured_at": "2026-08-01", "author": null, "contributor": null, "rationale": "The generation package import cycle was a dead re-export and was deleted. cli() startup sequencing was closed as cosmetic because database readiness already hides a deep migration orchestrator. GeneratorSession was split into WordPool and GenerationRunState because it conflated word-pool data with cross-stage mutable run state."}, {"id": "generator_session", "label": "GeneratorSession", "file_type": "concept", "source_file": "docs/adr/0008-architecture-review-2026-08-01.md", "source_location": "L10-L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GeneratorSession was a god object reached by dozens of callers; it now composes WordPool and GenerationRunState so word-pool data and cross-stage run state are separate."}, {"id": "word_pool", "label": "WordPool", "file_type": "concept", "source_file": "docs/adr/0008-architecture-review-2026-08-01.md", "source_location": "L78-L92", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Word-pool lists were split out of GeneratorSession so paradigm assigners and generators take the pool directly instead of the whole session."}, {"id": "generation_run_state", "label": "GenerationRunState", "file_type": "concept", "source_file": "docs/adr/0008-architecture-review-2026-08-01.md", "source_location": "L80-L92", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cross-stage scalars such as perl_probability and enable_r_stem_nouns are shared mutable run state by design and belong in one accumulator rather than on the word pool."}, {"id": "ensure_database_ready", "label": "ensure_database_ready", "file_type": "concept", "source_file": "docs/adr/0008-architecture-review-2026-08-01.md", "source_location": "L55-L73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Database readiness already hides migration, backup, and legacy-reset orchestration in wyrdcraeft/db/runtime.py, so extracting a CliBootstrap collaborator was not worth doing."}, {"id": "generation_facade_py", "label": "generation/facade.py", "file_type": "code", "source_file": "docs/adr/0008-architecture-review-2026-08-01.md", "source_location": "L13-L16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cli_py", "label": "wyrdcraeft/cli/cli.py", "file_type": "code", "source_file": "docs/adr/0008-architecture-review-2026-08-01.md", "source_location": "L17-L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "db_runtime_py", "label": "wyrdcraeft/db/runtime.py", "file_type": "code", "source_file": "docs/adr/0008-architecture-review-2026-08-01.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "morphology_session_py", "label": "wyrdcraeft/services/morphology/session.py", "file_type": "code", "source_file": "docs/adr/0008-architecture-review-2026-08-01.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "verb_engine_py", "label": "generation/verb_engine.py", "file_type": "code", "source_file": "docs/adr/0008-architecture-review-2026-08-01.md", "source_location": "L40-L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "verb_engine.py and common.py genuinely depend on each other; a deferred import breaks the load-time cycle and was left in place because deleting it without a shared interface would restore an ImportError. ADR 0009 later deletes verb_engine.py as pure redirection."}], "edges": [{"source"