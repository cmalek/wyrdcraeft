{"nodes": [{"id": "docs_adr_0004_bt_ocr_parsing_starts_with_lossless_source_grounded_ast", "label": "BT OCR parsing starts with lossless source-grounded AST", "file_type": "document", "source_file": "docs/adr/0004-bt-ocr-parsing-starts-with-lossless-source-grounded-ast.md", "source_location": "L1-L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parsing first builds a lossless source-grounded AST because the Bosworth-Toller source is messy, editorially layered, and OCR-noisy; early normalization drops information and hides parser mistakes, so every character must be an ordered typed fragment and uncertain text stays an unclassified fragment. Superseded: the OCR pipeline moved to wordwending."}, {"id": "lossless_source_grounded_ast", "label": "Lossless source-grounded AST", "file_type": "concept", "source_file": "docs/adr/0004-bt-ocr-parsing-starts-with-lossless-source-grounded-ast.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered typed source fragments account for every character, and unresolved text is kept as unclassified_remainder, because normalizing senses first hides parser mistakes."}, {"id": "wesan_case_bundle", "label": "wesan case bundle", "file_type": "concept", "source_file": "docs/adr/0004-bt-ocr-parsing-starts-with-lossless-source-grounded-ast.md", "source_location": "L11-L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "data/bt_cases/wesan/ grounds the AST decision in a real artifact: entry.raw.yaml is lossless-first and entry.normalized.yaml stays skeletal and downstream."}], "edges": [{"source": "docs_adr_0004_bt_ocr_parsing_starts_with_lossless_source_grounded_ast", "target": "lossless_source_grounded_ast", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-bt-ocr-parsing-starts-with-lossless-source-grounded-ast.md", "source_location": "L5", "weight": 1.0}, {"source": "docs_adr_0004_bt_ocr_parsing_starts_with_lossless_source_grounded_ast", "target": "wesan_case_bundle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-bt-ocr-parsing-starts-with-lossless-source-grounded-ast.md", "source_location": "L11", "weight": 1.0}, {"source": "docs_adr_0004_bt_ocr_parsing_starts_with_lossless_source_grounded_ast", "target": "docs_adr_0007_ocr_pipeline_moves_to_bochord", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-bt-ocr-parsing-starts-with-lossless-source-grounded-ast.md", "source_location": "L3", "weight": 1.0}, {"source": "docs_adr_0004_bt_ocr_parsing_starts_with_lossless_source_grounded_ast", "target": "docs_adr_0006_bt_jp2_witness_preparation_is_library_first", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-bt-ocr-parsing-starts-with-lossless-source-grounded-ast.md", "source_location": "L23-L25", "weight": 1.0}, {"source": "wesan_case_bundle", "target": "lossless_source_grounded_ast", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-bt-ocr-parsing-starts-with-lossless-source-grounded-ast.md", "source_location": "L13-L18", "weight": 1.0}], "hyperedges": []}