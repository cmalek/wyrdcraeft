/* Dictionary browse stylesheet (ADR 0026 "Layout" and "Results rows").
   Colours come from the ``wyrdcraeft`` theme (browse_theme.py); never hex here.
   Started from docs/superpowers/plans/browse-tcss-skeleton.tcss. */

Screen {
    layout: vertical;
    overflow: hidden;
    background: $background;
}

#search-input {
    margin: 1 1 0 1;
}

#copy-definition {
    min-width: 8;
    height: 1;
    border: none;
    padding: 0 1;
    margin: 0 0 0 2;
}

#oe-char-bar {
    height: auto;
    margin: 0 1 1 1;
}

.oe-char-button {
    min-width: 4;
    height: auto;
    margin: 0 1 0 0;
    padding: 0 1;
    text-style: bold;
    color: $foreground;
    background: $panel;
}

#body {
    layout: horizontal;
    height: 1fr;
    min-height: 0;
    overflow: hidden;
}

/* Panes: rounded titled borders. Focus takes the accent border AND an
   accent title, so it is never carried by colour alone. */
.pane {
    height: 1fr;
    min-height: 0;
    layout: vertical;
    overflow: hidden;
    background: $surface;
    border: round $border-blurred;
    border-title-color: $text-muted;
    border-title-align: left;
}

.pane.pane-focused {
    border: round $border;
    border-title-color: $primary;
    border-title-style: bold;
}

#results-pane {
    width: 1fr;
    margin: 0 1 1 1;
}

#results-list {
    height: 1fr;
    min-height: 0;
    background: $surface;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $border-blurred;
    scrollbar-color-hover: $text-muted;
    scrollbar-color-active: $primary;
}

/* Focus is carried by the pane border and title, not a list tint. */
#results-list:focus {
    background-tint: transparent;
}

#details-pane {
    width: 2fr;
    margin: 0 1 1 0;
}

/* Results rows: one cell of padding above and below, so a row is three
   cells tall; headword, dim definition line, then the POS tag. */
ListItem.result-row {
    layout: horizontal;
    height: 3;
    padding: 1 1 1 2;
    background: $surface;
}

ListItem.result-row.-highlight {
    background: $wyrd-selected-row;
}

#results-list:focus > ListItem.result-row.-highlight {
    background: $wyrd-selected-row;
    border-left: outer $primary;
    /* Full shorthand: a lone padding-left here resets the other edges. */
    padding: 1 1 1 1;
}

.result-headword {
    width: auto;
    max-width: 50%;
    height: 1;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: $foreground;
}

.result-definition {
    width: 1fr;
    height: 1;
    margin: 0 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.pos-tag {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $pos-unknown-text;
    background: $pos-unknown-tint;
}

.pos-tag.pos-noun { color: $pos-noun-text; background: $pos-noun-tint; }
.pos-tag.pos-verb { color: $pos-verb-text; background: $pos-verb-tint; }
.pos-tag.pos-adjective { color: $pos-adjective-text; background: $pos-adjective-tint; }
.pos-tag.pos-adverb { color: $pos-adverb-text; background: $pos-adverb-tint; }
.pos-tag.pos-pronoun { color: $pos-pronoun-text; background: $pos-pronoun-tint; }
.pos-tag.pos-numeral { color: $pos-numeral-text; background: $pos-numeral-tint; }
.pos-tag.pos-preposition { color: $pos-preposition-text; background: $pos-preposition-tint; }
.pos-tag.pos-conjunction { color: $pos-conjunction-text; background: $pos-conjunction-tint; }
.pos-tag.pos-interjection { color: $pos-interjection-text; background: $pos-interjection-tint; }
.pos-tag.pos-indeclinable { color: $pos-indeclinable-text; background: $pos-indeclinable-tint; }
.pos-tag.pos-unknown { color: $pos-unknown-text; background: $pos-unknown-tint; }

/* Entry pane (ADR 0026): a pinned banner, then one scrolling column of
   sections. A section with no content is never mounted. */
.banner {
    height: auto;
    margin: 1 2 0 2;
    padding: 1 2;
    background: $panel;
    border-left: thick $primary;
}

#entry-headword {
    width: 1fr;
    height: 1;
    text-style: bold;
    color: $primary-lighten-2;
}

#entry-column {
    height: 1fr;
    min-height: 0;
    padding: 0 2 1 2;
    /* A stable gutter keeps the forms column width the same whether or not
       the column scrolls (ADR 0027). Never a horizontal scrollbar. */
    scrollbar-gutter: stable;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $border-blurred;
    scrollbar-color-hover: $text-muted;
    scrollbar-color-active: $primary;
}

#entry-message {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
    color: $text-muted;
}

.entry-section {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
}

/* Section label: dim caps and a hairline rule to the right edge. */
.section-label {
    height: 1;
    margin: 0 0 1 0;
}

.section-label-text {
    width: auto;
    color: $text-muted;
}

Rule.section-rule {
    width: 1fr;
    margin: 0 0 0 2;
    color: $border-blurred;
}

#entry-keyvalues {
    layout: grid;
    grid-size: 2;
    grid-columns: auto 1fr;
    grid-rows: auto;
    grid-gutter: 0 3;
}

.kv-label {
    color: $text-muted;
}

.sense-row {
    height: auto;
}

.sense-number {
    width: 5;
}

.sense-gloss {
    width: 1fr;
}

/* Sub-senses (5a, 10c) indent by one number column. */
.sense-row.sub-sense {
    padding: 0 0 0 5;
}

.senses-summary {
    margin: 0 0 1 0;
}

.ety-table {
    height: auto;
    grid-rows: auto;
    grid-gutter: 0 3;
}

.ety-head {
    color: $text-muted;
}

.ety-word {
    color: $accent;
}

.ety-note {
    margin: 1 0 0 0;
}

/* Rows wrap to their own height; the table grows instead of scrolling
   inside the column, so it never takes its own scrollbars (ADR 0027).
   DataTable's default ``max-height: 100%`` would cap it at the viewport, and
   TCSS cannot unset it, so the cap is set far beyond any paradigm.
   ``browse_forms.fit_columns`` sizes the columns to the pane, so the table
   is never wider than its region; ``overflow-x: hidden`` also stops a stale
   scrollbar flag from a transient layout width being painted. The guard
   trades a scrollbar for clipping: a table wider than its region would be
   cut off silently, so the tests assert the column widths and painted forms
   directly rather than trusting the scrollbar flags. */
#morphology-table {
    height: auto;
    min-height: 0;
    max-height: 10000;
    overflow: hidden hidden;
}

#morphology-table > .datatable--header {
    color: $text-muted;
}

.forms-tabs {
    height: auto;
    margin: 0 0 1 0;
}

#forms-empty {
    height: auto;
}

#wright-sections-title {
    height: auto;
    margin: 0 1;
    text-style: bold;
}

#wright-sections-list {
    height: auto;
    max-height: 10;
    margin: 0 1 1 1;
}

#wright-sections-title.hidden,
#wright-sections-list.hidden {
    display: none;
}

WrightSectionTextScreen {
    align: center middle;
}

#wright-modal {
    width: 80%;
    height: 80%;
    border: round $border;
    background: $surface;
    padding: 1;
}

#wright-modal-title {
    height: auto;
    margin: 0 0 1 0;
    text-style: bold;
}

#wright-modal-scroll {
    height: 1fr;
    min-height: 0;
    width: 100%;
    border: round $border-blurred;
    padding: 0 1;
    margin: 0 0 1 0;
}

#wright-modal-text {
    width: 100%;
    height: auto;
}

#wright-modal-close {
    width: 16;
}

/* Footer (ADR 0026 "Layout", ADR 0028): keys in the ADR accent ($primary),
   descriptions muted. Only live keys are bound, so only they appear. */
Footer FooterKey .footer-key--key {
    color: $primary;
}

Footer FooterKey .footer-key--description,
Footer FooterLabel {
    color: $text-muted;
}
